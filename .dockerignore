# Release outputs bind the built image digest and must not become inputs to that
# same image.  Keeping them outside the context prevents a self-referential
# digest and makes repeated multi-architecture builds comparable.
configs/installation/generated
configs/installation/runtime-service-manifest.json
schemas/release
tools/release/*
