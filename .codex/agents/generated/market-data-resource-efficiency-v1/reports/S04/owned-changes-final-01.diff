+    instrument = InstrumentId(MarketId(1), Symbol(f"S{index:04d}USDT"))
+    return CandleWithMeta(
+        Candle(
+            instrument,
+            UtcTimestamp(stamp),
+            UtcTimestamp(stamp + timedelta(minutes=1)),
+            100.0,
+            101.0,
+            99.0,
+            100.5,
+            1.0,
+            100.0,
+        ),
+        CandleMeta(
+            "ws",
+            UtcTimestamp(datetime.now(UTC)),
+            UUID(int=1),
+            f"binance:spot:{instrument.symbol}",
+            1,
+            0.1,
+            10.0,
+        ),
+    )
