+def quantiles(values):
+    ordered = sorted(values)
+    return (
+        {
+            f"p{p}_ms": ordered[min(len(ordered) - 1, int((len(ordered) - 1) * p / 100))] * 1000
+            for p in [50, 95, 99]
+        }
+        if ordered
+        else {}
+    )
