{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/ui-design-program.schema.json",
  "title": "UI design program manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "program_id", "program_name", "revision", "status",
    "validation_profile", "source_contracts", "scope", "expected_inventory",
    "screens", "journeys", "coverage_profiles", "families", "waves", "gates", "responsive_policy",
    "invention_policy", "program_acceptance", "execution_artifacts"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-design-program/v1"},
    "program_id": {"type": "string", "minLength": 1},
    "program_name": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "review", "accepted", "superseded"]},
    "validation_profile": {"enum": ["draft", "atlas_gate", "structure_gate", "program_ready", "handoff_ready"]},
    "source_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "authority", "required_status", "sha256", "screen_collections", "journey_collections"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "authority": {"type": "string", "minLength": 1},
          "required_status": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"]},
          "screen_collections": {"type": "array", "items": {"$ref": "#/$defs/collectionRef"}},
          "journey_collections": {"type": "array", "items": {"$ref": "#/$defs/collectionRef"}}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "platform", "included_release_slices", "excluded_release_slices", "origin"],
      "properties": {
        "product": {"type": "string", "minLength": 1},
        "platform": {"const": "web"},
        "included_release_slices": {"type": "array", "items": {"type": "string"}},
        "excluded_release_slices": {"type": "array", "items": {"type": "string"}},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "expected_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "route_screens", "route_flows", "persistent_shells", "route_backed_transients", "overlays", "system_state_families", "internal_or_non_visual", "historical_exclusions", "journeys"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "route_screens": {"type": "integer", "minimum": 0},
        "route_flows": {"type": "integer", "minimum": 0},
        "persistent_shells": {"type": "integer", "minimum": 0},
        "route_backed_transients": {"type": "integer", "minimum": 0},
        "overlays": {"type": "integer", "minimum": 0},
        "system_state_families": {"type": "integer", "minimum": 0},
        "internal_or_non_visual": {"type": "integer", "minimum": 0},
        "historical_exclusions": {"type": "integer", "minimum": 0},
        "journeys": {"type": "integer", "minimum": 0}
      }
    },
    "screens": {
      "type": "array",
      "items": {"$ref": "#/$defs/screenEntry"}
    },
    "journeys": {
      "type": "array",
      "items": {"$ref": "#/$defs/journey"}
    },
    "coverage_profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverageProfile"}
    },
    "families": {
      "type": "array",
      "items": {"$ref": "#/$defs/family"}
    },
    "waves": {
      "type": "array",
      "items": {"$ref": "#/$defs/wave"}
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "title", "owner_decision_required"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^G[0-6]$"},
          "title": {"type": "string", "minLength": 1},
          "owner_decision_required": {"type": "boolean"}
        }
      }
    },
    "responsive_policy": {"$ref": "#/$defs/responsivePolicy"},
    "invention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "unknown_value", "implicit_screen_addition", "implicit_state_removal", "unsourced_visual_value", "agent_self_acceptance"],
      "properties": {
        "default": {"const": "forbidden"},
        "unknown_value": {"const": "record_and_block"},
        "implicit_screen_addition": {"const": "forbidden"},
        "implicit_state_removal": {"const": "forbidden"},
        "unsourced_visual_value": {"const": "forbidden"},
        "agent_self_acceptance": {"const": "forbidden"}
      }
    },
    "program_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_self_acceptance", "owner_decision_ref", "accepted_revision"],
      "properties": {
        "agent_self_acceptance": {"const": "prohibited"},
        "owner_decision_ref": {"type": ["string", "null"]},
        "accepted_revision": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "execution_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_doc", "prompt_pack_dir", "stage_ledger"],
      "properties": {
        "plan_doc": {"type": "string", "minLength": 1},
        "prompt_pack_dir": {"type": "string", "minLength": 1},
        "stage_ledger": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "screenEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_ref", "classification", "classification_origin", "disposition", "disposition_origin", "disposition_reason_ref", "review_consequence", "design_family_id", "family_assignment_origin", "wave_id", "wave_assignment_origin", "representative", "coverage_profile", "coverage_assignment_origin", "visual_baseline_ref", "unresolved_fields"],
      "properties": {
        "screen_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "json_pointer", "expected_id"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "json_pointer": {"type": "string", "pattern": "^/"},
            "expected_id": {"type": "string", "minLength": 1}
          }
        },
        "classification": {"enum": ["route_screen", "route_flow", "persistent_shell", "route_backed_transient", "overlay", "system_state_family", "internal_or_non_visual", "historical_exclusion"]},
        "classification_origin": {"$ref": "#/$defs/origin"},
        "disposition": {"enum": ["in_scope", "deferred", "excluded", "internal"]},
        "disposition_origin": {"$ref": "#/$defs/origin"},
        "disposition_reason_ref": {"type": ["string", "null"]},
        "review_consequence": {"type": ["string", "null"]},
        "design_family_id": {"type": ["string", "null"]},
        "family_assignment_origin": {"$ref": "#/$defs/origin"},
        "wave_id": {"type": ["string", "null"]},
        "wave_assignment_origin": {"$ref": "#/$defs/origin"},
        "representative": {"type": "boolean"},
        "coverage_profile": {"type": ["string", "null"]},
        "coverage_assignment_origin": {"$ref": "#/$defs/origin"},
        "visual_baseline_ref": {"type": ["string", "null"]},
        "unresolved_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_ref", "entry_screen_ids", "intermediate_screen_ids", "alternate_screen_ids", "failure_screen_ids", "recovery_screen_ids", "terminal_screen_ids", "external_boundary_ids", "transitions", "unresolved_fields"],
      "properties": {
        "journey_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "json_pointer", "expected_id"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "json_pointer": {"type": "string", "pattern": "^/"},
            "expected_id": {"type": "string", "minLength": 1}
          }
        },
        "entry_screen_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "intermediate_screen_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "alternate_screen_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "failure_screen_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "recovery_screen_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "terminal_screen_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "external_boundary_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/journeyTransition"}},
        "unresolved_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "journeyTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_ref", "from_id", "to_id", "outcome"],
      "properties": {
        "transition_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "json_pointer", "expected_id"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "json_pointer": {"type": "string", "pattern": "^/"},
            "expected_id": {"type": "string", "minLength": 1}
          }
        },
        "from_id": {"type": "string", "minLength": 1},
        "to_id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["forward", "alternate", "failure", "recovery", "retry", "back", "cancel", "terminal"]}
      }
    },
    "coverageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_profile_id", "state_ids", "role_ids", "locale_ids", "theme_ids", "viewport_anchor_ids", "unresolved_fields"],
      "properties": {
        "coverage_profile_id": {"type": "string", "minLength": 1},
        "state_ids": {"$ref": "#/$defs/sourcedIdentitySet"},
        "role_ids": {"$ref": "#/$defs/sourcedIdentitySet"},
        "locale_ids": {"$ref": "#/$defs/sourcedIdentitySet"},
        "theme_ids": {"$ref": "#/$defs/sourcedIdentitySet"},
        "viewport_anchor_ids": {"$ref": "#/$defs/sourcedIdentitySet"},
        "unresolved_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family_id", "title", "representative_screen_ids", "screen_ids", "reuse_hypothesis_status", "decision_origin"],
      "properties": {
        "family_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "representative_screen_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "screen_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "reuse_hypothesis_status": {"enum": ["unresolved", "hypothesis", "proven", "one_off"]},
        "decision_origin": {"$ref": "#/$defs/origin"}
      }
    },
    "wave": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave_id", "title", "family_ids", "depends_on", "gate_id", "decision_origin"],
      "properties": {
        "wave_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "family_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "gate_id": {"type": "string", "pattern": "^G[3-6]$"},
        "decision_origin": {"$ref": "#/$defs/origin"}
      }
    },
    "responsivePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adaptive_web_required", "supported_web_width_range", "anchor_viewports", "breakpoint_policy", "breakpoint_policy_origin", "component_adaptation", "component_adaptation_origin", "logical_properties_required", "logical_properties_origin", "mobile_scope", "mobile_scope_origin", "mobile_authorization_ref", "authorized_mobile_surfaces", "authorized_mobile_viewports", "allowed_mobile_changes"],
      "properties": {
        "adaptive_web_required": {"const": true},
        "supported_web_width_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_width", "max_width", "origin"],
          "properties": {
            "min_width": {"type": ["integer", "null"], "minimum": 1},
            "max_width": {"type": ["integer", "null"], "minimum": 1},
            "origin": {"$ref": "#/$defs/origin"}
          }
        },
        "anchor_viewports": {
          "type": "array",
          "items": {"$ref": "#/$defs/viewport"}
        },
        "breakpoint_policy": {"const": "content_driven"},
        "breakpoint_policy_origin": {"$ref": "#/$defs/origin"},
        "component_adaptation": {"const": "prefer_container_queries"},
        "component_adaptation_origin": {"$ref": "#/$defs/origin"},
        "logical_properties_required": {"const": true},
        "logical_properties_origin": {"$ref": "#/$defs/origin"},
        "mobile_scope": {"enum": ["unauthorized", "authorized"]},
        "mobile_scope_origin": {"$ref": "#/$defs/origin"},
        "mobile_authorization_ref": {"type": ["string", "null"]},
        "authorized_mobile_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authorized_mobile_viewports": {"type": "array", "items": {"$ref": "#/$defs/viewport"}},
        "allowed_mobile_changes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "width", "height", "class", "origin"],
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "class": {"enum": ["responsive_web", "mobile"]},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["product_contract", "normative_requirement", "accepted_visual", "measured_baseline", "design_token", "owner_decision", "derived_formula"]},
        "ref": {"type": "string", "minLength": 1},
        "locator": {"type": "string"},
        "property": {"type": "string"},
        "formula": {"type": "string"}
      }
    },
    "collectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "id_key"],
      "properties": {
        "json_pointer": {"type": "string", "pattern": "^/"},
        "id_key": {"type": "string", "minLength": 1}
      }
    },
    "sourcedIdentitySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "values", "origin", "not_applicable_reason_ref"],
      "properties": {
        "mode": {"enum": ["required", "not_applicable"]},
        "values": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "origin": {"$ref": "#/$defs/origin"},
        "not_applicable_reason_ref": {"type": ["string", "null"]}
      }
    }
  }
}
