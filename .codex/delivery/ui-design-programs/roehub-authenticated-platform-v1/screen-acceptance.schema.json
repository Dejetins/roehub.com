{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/screen-acceptance.schema.json",
  "title": "All-anchor screen acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "screen_revision_id", "generated_by", "contract_input", "required_anchor_ids", "anchor_receipts", "result", "blockers"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-screen-acceptance/v1"},
    "screen_revision_id": {"type": "string", "minLength": 1},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version", "command"],
      "properties": {
        "script": {"const": "assemble_screen_acceptance.py"},
        "version": {"const": "1.0.0"},
        "command": {"const": "assemble_screen_acceptance.py <paths-redacted>"}
      }
    },
    "contract_input": {"$ref": "#/$defs/evidenceInput"},
    "required_anchor_ids": {"type": "array", "items": {"type": "string"}, "minItems": 2, "uniqueItems": true},
    "anchor_receipts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchor_id", "path", "sha256", "result", "accessibility_passed", "keyboard_passed"],
        "properties": {
          "anchor_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"enum": ["passed", "blocked"]},
          "accessibility_passed": {"type": "boolean"},
          "keyboard_passed": {"type": "boolean"}
        }
      }
    },
    "result": {"enum": ["passed", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
