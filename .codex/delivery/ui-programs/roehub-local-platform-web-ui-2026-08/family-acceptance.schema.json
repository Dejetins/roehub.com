{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/family-acceptance.schema.json",
  "title": "Representative family acceptance aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "generated_by", "family_revision_id", "revision", "program_id", "program_revision", "program_input", "program_revision_ref", "family_id", "expected_screen_revision_ids", "screen_acceptance_receipts", "coverage", "review_board", "result", "blockers", "owner_decision_ref"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-family-acceptance/v1"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version", "command"],
      "properties": {
        "script": {"const": "assemble_family_acceptance.py"},
        "version": {"const": "1.1.0"},
        "command": {"const": "assemble_family_acceptance.py <paths-redacted>"}
      }
    },
    "family_revision_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "program_id": {"type": "string", "minLength": 1},
    "program_revision": {"type": "integer", "minimum": 1},
    "program_input": {"$ref": "#/$defs/evidenceRef"},
    "program_revision_ref": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "expected_screen_revision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "screen_acceptance_receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["screen_revision_id", "screen_id", "state_id", "path", "sha256", "result"],
        "properties": {
          "screen_revision_id": {"type": "string", "minLength": 1},
          "screen_id": {"type": "string", "minLength": 1},
          "state_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "result": {"const": "passed"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_screen_state_ids", "accepted_screen_state_ids"],
      "properties": {
        "required_screen_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "accepted_screen_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "review_board": {"$ref": "#/$defs/evidenceRef"},
    "result": {"enum": ["review_ready", "passed", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "owner_decision_ref": {"type": ["string", "null"]}
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
