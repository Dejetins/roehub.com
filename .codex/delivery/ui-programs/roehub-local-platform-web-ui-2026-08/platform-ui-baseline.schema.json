{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/platform-ui-baseline.schema.json",
  "title": "Immutable platform UI baseline extracted from an accepted pilot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "contract_profile", "baseline_id", "revision", "status",
    "source_visual", "scope", "supporting_sources", "default_shell_variant_id", "shell_variants",
    "navigation_contracts", "foundation_tokens", "font_contract",
    "asset_contract", "icon_contract", "component_contracts",
    "interaction_patterns", "layout_contract", "responsive_contract",
    "accessibility_contract", "exceptions", "change_control",
    "unresolved_inputs"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.platform-ui-baseline/v1"},
    "contract_profile": {"const": "codex.platform-ui-baseline/v1@1.0.0"},
    "baseline_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "accepted", "superseded"]},
    "source_visual": {"$ref": "#/$defs/sourceVisual"},
    "scope": {"$ref": "#/$defs/scope"},
    "supporting_sources": {"type": "array", "items": {"$ref": "#/$defs/supportingSource"}},
    "default_shell_variant_id": {"type": "string", "minLength": 1},
    "shell_variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shellVariant"}},
    "navigation_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/navigationContract"}},
    "foundation_tokens": {"$ref": "#/$defs/foundationTokens"},
    "font_contract": {"$ref": "#/$defs/fontContract"},
    "asset_contract": {"$ref": "#/$defs/assetContract"},
    "icon_contract": {"$ref": "#/$defs/iconContract"},
    "component_contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentContract"}},
    "interaction_patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interactionPattern"}},
    "layout_contract": {"$ref": "#/$defs/layoutContract"},
    "responsive_contract": {"$ref": "#/$defs/responsiveContract"},
    "accessibility_contract": {"$ref": "#/$defs/accessibilityContract"},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}},
    "change_control": {"$ref": "#/$defs/changeControl"},
    "unresolved_inputs": {"type": "array", "items": {"$ref": "#/$defs/unresolvedInput"}}
  },
  "$defs": {
    "specifiedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "source_ref", "tolerance", "change_policy"],
      "properties": {
        "value": {},
        "unit": {"type": ["string", "null"]},
        "source_ref": {"type": "string", "minLength": 1},
        "tolerance": {"type": "number", "minimum": 0},
        "change_policy": {"const": "fixed"}
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_id", "value", "usage"],
      "properties": {
        "token_id": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/specifiedValue"},
        "usage": {"type": "string", "minLength": 1}
      }
    },
    "sourceVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "owner_decision_ref", "native_viewport", "state_id", "theme_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "owner_decision_ref": {"type": "string", "minLength": 1},
        "native_viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "state_id": {"type": "string", "minLength": 1},
        "theme_id": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_acceptance_scope", "visual_language_scope", "reusable_foundation_scope", "inheritance_policy", "mobile_scope"],
      "properties": {
        "screen_acceptance_scope": {"type": "string", "minLength": 1},
        "visual_language_scope": {"type": "string", "minLength": 1},
        "reusable_foundation_scope": {"type": "string", "minLength": 1},
        "inheritance_policy": {"const": "required"},
        "mobile_scope": {"enum": ["unauthorized", "authorized"]}
      }
    },
    "supportingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "authority", "covers"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority": {"type": "string", "minLength": 1},
        "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["product", "tokens", "fonts", "assets", "icons", "responsive", "accessibility", "copy"]}}
      }
    },
    "shellRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "role", "presence", "not_applicable_reason", "order", "geometry", "spacing_relations", "visual_properties", "scroll_behavior", "source_refs"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["header", "primary_navigation", "secondary_navigation", "workspace", "context_panel", "detail_panel", "status_line", "overlay_root", "other"]},
        "presence": {"enum": ["required", "not_applicable"]},
        "not_applicable_reason": {"type": ["string", "null"]},
        "order": {"type": "integer", "minimum": 0},
        "geometry": {
          "oneOf": [
            {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
            {"type": "null"}
          ]
        },
        "spacing_relations": {"type": "array", "items": {"$ref": "#/$defs/spacingRelation"}},
        "visual_properties": {
          "oneOf": [
            {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
            {"type": "null"}
          ]
        },
        "scroll_behavior": {"type": ["string", "null"], "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "allOf": [
        {
          "if": {"properties": {"presence": {"const": "required"}}},
          "then": {
            "properties": {
              "not_applicable_reason": {"type": "null"},
              "geometry": {"type": "object", "minProperties": 1},
              "visual_properties": {"type": "object", "minProperties": 1},
              "scroll_behavior": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"presence": {"const": "not_applicable"}}},
          "then": {
            "properties": {
              "not_applicable_reason": {"type": "string", "minLength": 1},
              "geometry": {"type": "null"},
              "spacing_relations": {"maxItems": 0},
              "visual_properties": {"type": "null"},
              "scroll_behavior": {"type": "null"}
            }
          }
        }
      ]
    },
    "shellVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant_id", "variant_kind", "is_default", "screen_ids", "applicability", "regions", "allowed_differences", "owner_decision_ref"],
      "properties": {
        "variant_id": {"type": "string", "minLength": 1},
        "variant_kind": {"enum": ["authenticated_application", "shellless_auth", "setup", "public", "full_screen_focus", "system_recovery", "other"]},
        "is_default": {"type": "boolean"},
        "screen_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "applicability": {"type": "string", "minLength": 1},
        "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shellRegion"}},
        "allowed_differences": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "owner_decision_ref": {"type": ["string", "null"]}
      }
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "order", "label", "icon_id", "destination", "active_match", "group_id", "visibility", "tooltip", "source_refs"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "minLength": 1},
        "icon_id": {"type": "string", "minLength": 1},
        "destination": {"type": "string", "minLength": 1},
        "active_match": {"type": "string", "minLength": 1},
        "group_id": {"type": ["string", "null"]},
        "visibility": {"type": "string", "minLength": 1},
        "tooltip": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "navigationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["navigation_id", "shell_variant_id", "region_id", "orientation", "items", "profile_area", "responsive_behavior", "identity_change_policy"],
      "properties": {
        "navigation_id": {"type": "string", "minLength": 1},
        "shell_variant_id": {"type": "string", "minLength": 1},
        "region_id": {"type": "string", "minLength": 1},
        "orientation": {"enum": ["vertical", "horizontal"]},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/navigationItem"}},
        "profile_area": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "responsive_behavior": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/specifiedValue"}},
        "identity_change_policy": {"const": "labels_order_icons_groups_destinations_fixed"}
      }
    },
    "foundationTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "typography", "spacing", "sizing", "radius", "border", "elevation", "opacity", "motion", "z_index"],
      "properties": {
        "color": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "typography": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "spacing": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "sizing": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "radius": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "border": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "elevation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "opacity": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "motion": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}},
        "z_index": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/token"}}
      }
    },
    "fontContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "bundle_path", "bundle_sha256", "fallback_policy", "source_refs"],
      "properties": {
        "families": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "bundle_path": {"type": ["string", "null"]},
        "bundle_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "fallback_policy": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "assetContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_paths", "bundle_sha256s", "replacement_policy", "source_refs"],
      "properties": {
        "bundle_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "bundle_sha256s": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "replacement_policy": {"const": "exact_assets_only"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "iconContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["library", "version_or_commit", "source_path", "source_sha256", "icons", "default_size", "default_stroke_width", "fill_policy", "optical_alignment", "source_refs", "forbidden_replacements"],
      "properties": {
        "library": {"type": "string", "minLength": 1},
        "version_or_commit": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "icons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["icon_id", "source_name", "source_ref"],
            "properties": {
              "icon_id": {"type": "string", "minLength": 1},
              "source_name": {"type": "string", "minLength": 1},
              "source_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "default_size": {"$ref": "#/$defs/specifiedValue"},
        "default_stroke_width": {"$ref": "#/$defs/specifiedValue"},
        "fill_policy": {"type": "string", "minLength": 1},
        "optical_alignment": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden_replacements": {"type": "array", "minItems": 4, "items": {"enum": ["emoji", "unicode_glyph", "improvised_svg", "css_drawing"]}, "uniqueItems": true}
      }
    },
    "spacingRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "property", "value"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "property": {"enum": ["gap", "margin", "padding", "inset", "alignment", "distribution"]},
        "value": {"$ref": "#/$defs/specifiedValue"}
      }
    },
    "componentState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "geometry", "visual_properties", "content_behavior", "interaction_behavior", "source_refs"],
      "properties": {
        "state_id": {"enum": ["default", "hover", "focus_visible", "active", "selected", "disabled", "loading", "error"]},
        "geometry": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "visual_properties": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "content_behavior": {"type": "string", "minLength": 1},
        "interaction_behavior": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "componentContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "component_kind", "variants", "size_classes", "required_states", "not_applicable_states", "states", "internal_elements", "spacing_relations", "content_rules", "accessibility", "source_refs"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "component_kind": {"type": "string", "minLength": 1},
        "variants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "size_classes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "required_states": {"type": "array", "minItems": 1, "items": {"enum": ["default", "hover", "focus_visible", "active", "selected", "disabled", "loading", "error"]}, "uniqueItems": true},
        "not_applicable_states": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/componentState"}},
        "internal_elements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "spacing_relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spacingRelation"}},
        "content_rules": {"type": "string", "minLength": 1},
        "accessibility": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "interactionPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "kind", "trigger", "placement", "dismissal", "focus_behavior", "keyboard_behavior", "geometry", "spacing_relations", "states", "source_refs"],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["context_menu", "dropdown", "popover", "tooltip", "dialog", "drawer", "notification", "table", "form", "chart", "tabs", "scrollbar", "splitter", "other"]},
        "trigger": {"type": "string", "minLength": 1},
        "placement": {"type": "string", "minLength": 1},
        "dismissal": {"type": "string", "minLength": 1},
        "focus_behavior": {"type": "string", "minLength": 1},
        "keyboard_behavior": {"type": "string", "minLength": 1},
        "geometry": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "spacing_relations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spacingRelation"}},
        "states": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "layoutContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid", "content_width", "scroll_policy", "region_gap_rules", "layering_rules", "source_refs"],
      "properties": {
        "grid": {"type": "string", "minLength": 1},
        "content_width": {"type": "string", "minLength": 1},
        "scroll_policy": {"type": "string", "minLength": 1},
        "region_gap_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/spacingRelation"}},
        "layering_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "width", "height", "state_id", "theme_id", "source_ref"],
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "state_id": {"type": "string", "minLength": 1},
        "theme_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "shellTransformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transformation_id", "min_width", "max_width", "affected_region_ids", "behavior", "preserved_invariants", "source_ref"],
      "properties": {
        "transformation_id": {"type": "string", "minLength": 1},
        "min_width": {"type": "integer", "minimum": 1},
        "max_width": {"type": "integer", "minimum": 1},
        "affected_region_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "behavior": {"type": "string", "minLength": 1},
        "preserved_invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "source_ref": {"type": "string", "minLength": 1}
      }
    },
    "responsiveContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported_web_width_range", "anchor_viewports", "breakpoint_policy", "shell_transformations", "navigation_identity_must_remain_exact", "component_adaptation", "overflow_policy", "zoom_policy", "localization_stress_policy", "below_supported_range", "above_supported_range", "source_refs"],
      "properties": {
        "supported_web_width_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_width", "max_width"],
          "properties": {
            "min_width": {"type": "integer", "minimum": 1},
            "max_width": {"type": "integer", "minimum": 1}
          }
        },
        "anchor_viewports": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/viewport"}},
        "breakpoint_policy": {"const": "content_driven"},
        "shell_transformations": {"type": "array", "items": {"$ref": "#/$defs/shellTransformation"}},
        "navigation_identity_must_remain_exact": {"const": true},
        "component_adaptation": {"const": "prefer_container_queries"},
        "overflow_policy": {"type": "string", "minLength": 1},
        "zoom_policy": {"type": "string", "minLength": 1},
        "localization_stress_policy": {"type": "string", "minLength": 1},
        "below_supported_range": {"enum": ["out_of_scope", "graceful_overflow", "explicit_contract"]},
        "above_supported_range": {"enum": ["out_of_scope", "max_content_width", "explicit_contract"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "accessibilityContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus_indicator", "keyboard_navigation", "target_size", "contrast", "reduced_motion", "source_refs"],
      "properties": {
        "focus_indicator": {"type": "string", "minLength": 1},
        "keyboard_navigation": {"type": "string", "minLength": 1},
        "target_size": {"type": "string", "minLength": 1},
        "contrast": {"type": "string", "minLength": 1},
        "reduced_motion": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exception_id", "screen_ids", "shell_variant_id", "allowed_differences", "reason_ref", "owner_decision_ref"],
      "properties": {
        "exception_id": {"type": "string", "minLength": 1},
        "screen_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "shell_variant_id": {"type": "string", "minLength": 1},
        "allowed_differences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reason_ref": {"type": "string", "minLength": 1},
        "owner_decision_ref": {"type": "string", "minLength": 1}
      }
    },
    "changeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_change_policy", "fixed_domains", "exception_requires_owner_decision", "delegated_design_may_change_fixed_domains"],
      "properties": {
        "default_change_policy": {"const": "fixed"},
        "fixed_domains": {"type": "array", "minItems": 10, "items": {"enum": ["shell", "navigation", "foundation_tokens", "font_contract", "asset_contract", "icon_contract", "component_contracts", "interaction_patterns", "layout_contract", "responsive_contract", "accessibility_contract"]}},
        "exception_requires_owner_decision": {"const": true},
        "delegated_design_may_change_fixed_domains": {"const": false}
      }
    },
    "unresolvedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "path", "decision_class", "question", "why_needed", "recommended_answer"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "decision_class": {"enum": ["agent_decidable", "owner_required", "external_authority"]},
        "question": {"type": "string", "minLength": 1},
        "why_needed": {"type": "string", "minLength": 1},
