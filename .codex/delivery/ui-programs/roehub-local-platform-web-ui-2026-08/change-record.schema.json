{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/change-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "program_id", "change_id", "change_kind", "target", "owner_input", "recorded_by"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-change-record/v1"},
    "program_id": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1},
    "change_kind": {"enum": ["bounded_unaccepted_visual", "accepted_family_visual", "accepted_wave_local", "g3_realization_inside_accepted_baseline", "family_wave_coverage_structure", "atlas_identity_classification", "product_semantics_scope_or_mobile", "baseline_or_visual_authority_replacement"]},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_instance_id", "artifact_ref", "artifact_sha256"],
      "properties": {
        "stage_instance_id": {"type": "string", "minLength": 1},
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "owner_input": {"type": "string", "minLength": 1},
    "recorded_by": {"const": "agent"}
  }
}
