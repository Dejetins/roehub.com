{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/contract-versions.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "version", "active", "historical_read_only"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-design-contract-versions/v1"},
    "version": {"const": "1.0.0"},
    "active": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_profile", "program_contract", "screen_contract",
        "intake_contract", "baseline_contract", "capture_tool",
        "raster_diff_tool",
        "visual_qa_assembler", "screen_acceptance_assembler",
        "owner_decision_assembler", "owner_input_response_assembler", "render_provenance_assembler", "change_impact_assembler", "family_acceptance_assembler",
        "wave_acceptance_assembler", "journey_proof_assembler",
        "implementation_handoff_assembler", "transition_assembler"
      ],
      "properties": {
        "runtime_profile": {"type": "string", "minLength": 1},
        "program_contract": {"type": "string", "minLength": 1},
        "screen_contract": {"type": "string", "minLength": 1},
        "intake_contract": {"type": "string", "minLength": 1},
        "baseline_contract": {"type": "string", "minLength": 1},
        "capture_tool": {"type": "string", "minLength": 1},
        "raster_diff_tool": {"type": "string", "minLength": 1},
        "visual_qa_assembler": {"type": "string", "minLength": 1},
        "screen_acceptance_assembler": {"type": "string", "minLength": 1},
        "owner_decision_assembler": {"type": "string", "minLength": 1},
        "owner_input_response_assembler": {"type": "string", "minLength": 1},
        "render_provenance_assembler": {"type": "string", "minLength": 1},
        "change_impact_assembler": {"type": "string", "minLength": 1},
        "family_acceptance_assembler": {"type": "string", "minLength": 1},
        "wave_acceptance_assembler": {"type": "string", "minLength": 1},
        "journey_proof_assembler": {"type": "string", "minLength": 1},
        "implementation_handoff_assembler": {"type": "string", "minLength": 1},
        "transition_assembler": {"type": "string", "minLength": 1}
      }
    },
    "historical_read_only": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_profiles", "program_contracts", "screen_contracts"],
      "properties": {
        "runtime_profiles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "program_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "screen_contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
