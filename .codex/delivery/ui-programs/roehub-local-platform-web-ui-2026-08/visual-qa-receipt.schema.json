{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/visual-qa-receipt.schema.json",
  "title": "Machine-generated visual QA receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "screen_revision_id", "anchor_id", "contract_sha256", "generated_by", "evidence_inputs", "environment", "captures", "geometry", "computed_style_mismatches", "missing_required_regions", "unexpected_visible_regions", "console_errors", "request_failures", "accessibility", "pixel_diff", "mobile_scope", "result", "blockers"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-visual-qa-receipt/v1"},
    "screen_revision_id": {"type": "string", "minLength": 1},
    "anchor_id": {"type": "string", "minLength": 1},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version", "command"],
      "properties": {
        "script": {"const": "assemble_visual_qa_receipt.py"},
        "version": {"const": "1.4.0"},
        "command": {"type": "string", "minLength": 1}
      }
    },
    "evidence_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "reference_geometry", "implementation_geometry", "raster"],
      "properties": {
        "contract": {"$ref": "#/$defs/evidenceInput"},
        "reference_geometry": {"$ref": "#/$defs/evidenceInput"},
        "implementation_geometry": {"$ref": "#/$defs/evidenceInput"},
        "raster": {"$ref": "#/$defs/evidenceInput"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "viewport", "device_scale_factor", "locale", "theme", "font_bundle_sha256", "fixture_sha256"],
      "properties": {
        "browser": {"type": "string", "minLength": 1},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {"width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
        },
        "device_scale_factor": {"type": "number", "minimum": 0.1},
        "locale": {"type": "string", "minLength": 1},
        "theme": {"type": "string", "minLength": 1},
        "font_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "captures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_sha256", "implementation_sha256"],
      "properties": {
        "reference_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": true,
      "required": ["purpose", "provenance_passed", "proves_fidelity"],
      "properties": {
        "purpose": {"enum": ["deterministic_render", "source_fidelity", "native_image_comparison", "visual_language_conformance"]},
        "provenance_passed": {"type": "boolean"},
        "proves_fidelity": {"type": "boolean"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["visible_action_ids", "observed_outcomes", "unresolved_visible_actions", "unexpected_file_urls", "required_checks", "passed"],
      "properties": {
        "visible_action_ids": {"type": "array", "items": {"type": "string"}},
        "observed_outcomes": {"type": "array", "items": {"type": "object"}},
        "unresolved_visible_actions": {"type": "array", "items": {"type": "string"}},
        "unexpected_file_urls": {"type": "array", "items": {"type": "string"}},
        "required_checks": {"type": "array", "items": {"type": "object"}},
        "passed": {"type": "boolean"}
      }
    },
    "geometry": {"type": "array", "items": {"type": "object"}},
    "computed_style_mismatches": {"type": "array", "items": {"type": "object"}},
    "missing_required_regions": {"type": "array", "items": {"type": "string"}},
    "unexpected_visible_regions": {"type": "array", "items": {"type": "string"}},
    "console_errors": {"type": "array", "items": {"type": "string"}},
    "request_failures": {"type": "array", "items": {"type": "string"}},
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated_violations", "keyboard_issues", "keyboard_sequence", "focusable_count", "passed"],
      "properties": {
        "automated_violations": {"type": "array", "items": {"type": "string"}},
        "keyboard_issues": {"type": "array", "items": {"type": "string"}},
        "keyboard_sequence": {"type": "array", "items": {"type": "string"}},
        "focusable_count": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "pixel_diff": {
      "type": "object",
      "required": ["different_pixels", "different_ratio", "maximum_channel_delta", "channel_threshold", "approved_max_different_pixels", "passed"],
      "additionalProperties": false,
      "properties": {
        "dimensions_match": {"type": "boolean"},
        "reference_size": {"type": "array", "items": {"type": "integer"}},
        "implementation_size": {"type": "array", "items": {"type": "integer"}},
        "different_pixels": {"type": "integer", "minimum": 0},
        "different_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_channel_delta": {"type": "integer", "minimum": 0, "maximum": 255},
        "channel_threshold": {"type": "integer", "minimum": 0, "maximum": 255},
        "approved_max_different_pixels": {"type": "integer", "minimum": 0},
        "passed": {"type": "boolean"}
      }
    },
    "mobile_scope": {"enum": ["unauthorized", "authorized"]},
    "result": {"enum": ["passed", "blocked"]},
    "blockers": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
