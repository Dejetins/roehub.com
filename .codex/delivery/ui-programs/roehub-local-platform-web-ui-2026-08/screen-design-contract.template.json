{
  "$schema": "screen-design-contract.schema.json",
  "schema_id": "codex.ui-screen-design-contract/v1",
  "contract_profile": "codex.ui-screen-design-contract/v1@1.4.0",
  "screen_revision_id": "<screen-state-role-locale-theme-revision>",
  "program_revision_ref": "<program-id>@<revision>",
  "functional_contract_ref": {
    "path": "<ui-program-intake-path>",
    "sha256": "<ui-program-intake-sha256>",
    "json_pointer": "<exact-screen-json-pointer>",
    "screen_id": "<screen-id>"
  },
  "baseline_binding": {
    "baseline_id": "<platform-baseline-id>",
    "path": "<platform-ui-baseline-path>",
    "sha256": "<platform-ui-baseline-sha256>",
    "shell_variant_id": "<shell-variant-id>",
    "exception_id": null
  },
  "status": "draft",
  "product_identity": {
    "screen_id": "<screen-id>",
    "route_id": null,
    "route": null,
    "state_id": "<state-id>",
    "role_id": "<role-id>",
    "permission_profile": "<permission-profile>",
    "locale": "<locale>",
    "theme": "<theme>"
  },
  "source_visual": {
    "kind": "baseline_reference",
    "evidence_mode": "visual_language_only",
    "html_path": null,
    "image_path": null,
    "html_sha256": null,
    "image_sha256": null,
    "owner_decision_ref": null,
    "delegation_ref": "references/stage-transition-contract-v1.md#delegated-design-envelope"
  },
  "visual_authority": {
    "source_visual_ref": "<accepted-pilot-path>",
    "source_visual_sha256": "<accepted-pilot-sha256>",
    "owner_decision_ref": "<accepted-pilot-owner-decision>",
    "screen_acceptance_scope": "<exact-screen-scope>",
    "visual_language_scope": "<exact-platform-visual-scope>",
    "reusable_foundation_scope": "<exact-foundation-scope>",
    "inheritance_policy": "required",
    "mobile_scope": "unauthorized"
  },
  "comparison_claims": {
    "required_purpose": "visual_language_conformance",
    "deterministic_render_proves_fidelity": false,
    "reference_logical_artifact_id": "<accepted-reference-artifact-id>",
    "implementation_logical_artifact_id": "<candidate-artifact-id>"
  },
  "interaction_contract": {
    "visible_actions": [],
    "no_actions_reason_ref": null,
    "required_checks": [
      "keyboard_activation", "focus_visibility", "tab_radio_behavior", "menus",
      "toggles", "refresh_feedback", "state_transitions",
      "no_unresolved_file_navigation", "no_console_errors",
      "no_request_failures", "no_page_horizontal_overflow"
    ],
    "allowed_origins": ["http://localhost:4173", "http://127.0.0.1:4173", "http://[::1]:4173"],
    "fixture_mode": "isolated_local",
    "evidence_redaction_required": true,
    "redaction_selectors": ["[data-sensitive]", "input[type='password']"]
  },
  "render_environment": {
    "browser": "<pinned-browser-and-revision>",
    "browser_mechanic": "playwright_cli",
    "device_scale_factor": 1,
    "timezone": "<timezone>",
    "fixed_clock_iso": "<fixed-clock-iso>",
    "reduced_motion": true,
    "animations": "disabled",
    "fixture_data_path": "<fixture-path>",
    "fixture_data_sha256": null,
    "font_bundle_sha256": null,
    "asset_bundle_sha256": null
  },
  "viewport_contract": {
    "mode": "responsive_web",
    "supported_web_width_range": {
      "min_width": null,
      "max_width": null,
      "origin": {"kind": "owner_decision", "ref": "<exact-range-decision>"}
    },
    "anchors": [],
    "breakpoint_policy": "content_driven",
    "breakpoint_policy_origin": {"kind": "normative_requirement", "ref": "references/responsive-policy-v1.md#breakpoints-and-components"},
    "below_supported_range": "out_of_scope",
    "below_supported_range_origin": {"kind": "owner_decision", "ref": "<exact-range-decision>"},
    "above_supported_range": "out_of_scope",
    "above_supported_range_origin": {"kind": "owner_decision", "ref": "<exact-range-decision>"},
    "mobile_scope": "unauthorized",
    "mobile_scope_origin": {"kind": "normative_requirement", "ref": "references/responsive-policy-v1.md#mobile-authorization-boundary"},
    "mobile_authorization_ref": null,
    "mobile_specific_composition": false,
    "authorized_mobile_surfaces": [],
    "authorized_mobile_viewports": [],
    "allowed_mobile_changes": []
  },
  "regions": [],
  "element_contracts": [],
  "allowed_provenance_kinds": [
    "product_contract",
    "normative_requirement",
    "accepted_visual",
    "measured_baseline",
    "design_token",
    "owner_decision",
    "derived_formula",
    "delegated_design_decision"
  ],
  "unresolved_decisions": [],
  "acceptance": {
    "agent_self_acceptance": "prohibited",
    "machine_receipt_required": true,
    "owner_decision_required": true,
    "owner_decision_ref": null,
    "screen_acceptance_receipt_path": null,
    "screen_acceptance_receipt_sha256": null,
    "pixel_diff_policy": {
      "channel_threshold": {
        "value": 0,
        "unit": "channel-value",
        "origin": {"kind": "normative_requirement", "ref": "references/visual-provenance-contract-v1.md#pixel-and-geometry-evidence"},
        "tolerance": 0,
        "change_policy": "owner_approval_required"
      },
      "approved_max_different_pixels": {
        "value": 0,
        "unit": "px",
        "origin": {"kind": "normative_requirement", "ref": "references/visual-provenance-contract-v1.md#pixel-and-geometry-evidence"},
        "tolerance": 0,
        "change_policy": "owner_approval_required"
      }
    }
  }
}
