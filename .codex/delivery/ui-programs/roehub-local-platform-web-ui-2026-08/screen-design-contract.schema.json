{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/screen-design-contract.schema.json",
  "title": "Exact UI screen design contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "screen_revision_id", "program_revision_ref", "status", "product_identity", "source_visual", "render_environment", "viewport_contract", "regions", "allowed_provenance_kinds", "unresolved_decisions", "acceptance"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-screen-design-contract/v1"},
    "contract_profile": {"enum": ["codex.ui-screen-design-contract/v1@1.1.0", "codex.ui-screen-design-contract/v1@1.2.0", "codex.ui-screen-design-contract/v1@1.3.0", "codex.ui-screen-design-contract/v1@1.4.0"]},
    "screen_revision_id": {"type": "string", "minLength": 1},
    "program_revision_ref": {"type": "string", "minLength": 1},
    "functional_contract_ref": {"$ref": "#/$defs/functionalContractRef"},
    "baseline_binding": {"$ref": "#/$defs/baselineBinding"},
    "status": {"enum": ["draft", "review", "accepted", "superseded"]},
    "product_identity": {"$ref": "#/$defs/productIdentity"},
    "source_visual": {"$ref": "#/$defs/sourceVisual"},
    "visual_authority": {"$ref": "#/$defs/visualAuthority"},
    "comparison_claims": {"$ref": "#/$defs/comparisonClaims"},
    "interaction_contract": {"$ref": "#/$defs/interactionContract"},
    "render_environment": {"$ref": "#/$defs/renderEnvironment"},
    "viewport_contract": {"$ref": "#/$defs/viewportContract"},
    "regions": {
      "type": "array",
      "items": {"$ref": "#/$defs/region"}
    },
    "element_contracts": {
      "type": "array",
      "items": {"$ref": "#/$defs/elementContract"}
    },
    "allowed_provenance_kinds": {
      "type": "array",
      "items": {"enum": ["product_contract", "normative_requirement", "accepted_visual", "measured_baseline", "design_token", "owner_decision", "derived_formula", "delegated_design_decision"]},
      "uniqueItems": true
    },
    "unresolved_decisions": {"type": "array", "items": {"type": "object"}},
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_self_acceptance", "machine_receipt_required", "owner_decision_required", "owner_decision_ref", "screen_acceptance_receipt_path", "screen_acceptance_receipt_sha256", "pixel_diff_policy"],
      "properties": {
        "agent_self_acceptance": {"const": "prohibited"},
        "machine_receipt_required": {"const": true},
        "owner_decision_required": {"const": true},
        "owner_decision_ref": {"type": ["string", "null"]},
        "screen_acceptance_receipt_path": {"type": ["string", "null"]},
        "screen_acceptance_receipt_sha256": {"type": ["string", "null"]},
        "pixel_diff_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel_threshold", "approved_max_different_pixels"],
          "properties": {
            "channel_threshold": {"$ref": "#/$defs/specifiedValue"},
            "approved_max_different_pixels": {"$ref": "#/$defs/specifiedValue"}
          }
        }
      }
    }
  },
  "$defs": {
    "functionalContractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "json_pointer", "screen_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "screen_id": {"type": "string", "minLength": 1}
      }
    },
    "baselineBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "path", "sha256", "shell_variant_id", "exception_id"],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "shell_variant_id": {"type": ["string", "null"]},
        "exception_id": {"type": ["string", "null"]}
      }
    },
    "elementContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "element_id", "parent_element_id", "region_id", "locator", "visibility", "element_type",
        "component_id", "variant", "size_class", "content_contract", "icon_id",
        "action_ids", "state_ids", "responsive_behavior", "accessibility", "source_refs"
      ],
      "properties": {
        "element_id": {"type": "string", "minLength": 1},
        "parent_element_id": {"type": ["string", "null"]},
        "region_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["required", "conditional", "forbidden"]},
        "element_type": {"type": "string", "minLength": 1},
        "component_id": {"type": ["string", "null"]},
        "variant": {"type": ["string", "null"]},
        "size_class": {"type": ["string", "null"]},
        "content_contract": {"type": "string", "minLength": 1},
        "icon_id": {"type": ["string", "null"]},
        "action_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "state_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "geometry": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "spacing_relations": {"type": "array", "items": {"$ref": "#/$defs/specifiedValue"}, "minItems": 1},
        "visual_properties": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "responsive_behavior": {"type": "array", "items": {"$ref": "#/$defs/specifiedValue"}, "minItems": 1},
        "accessibility": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/origin"}, "minItems": 1}
      }
    },
    "visualAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_visual_ref", "source_visual_sha256", "owner_decision_ref", "screen_acceptance_scope", "visual_language_scope", "reusable_foundation_scope", "inheritance_policy", "mobile_scope"],
      "properties": {
        "source_visual_ref": {"type": "string", "minLength": 1},
        "source_visual_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "owner_decision_ref": {"type": "string", "minLength": 1},
        "screen_acceptance_scope": {"type": "string", "minLength": 1},
        "visual_language_scope": {"type": "string", "minLength": 1},
        "reusable_foundation_scope": {"type": "string", "minLength": 1},
        "inheritance_policy": {"enum": ["required", "explicit_exception"]},
        "mobile_scope": {"enum": ["unauthorized", "authorized"]}
      }
    },
    "comparisonClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_purpose", "deterministic_render_proves_fidelity", "reference_logical_artifact_id", "implementation_logical_artifact_id"],
      "properties": {
        "required_purpose": {"enum": ["deterministic_render", "source_fidelity", "native_image_comparison", "visual_language_conformance"]},
        "deterministic_render_proves_fidelity": {"const": false},
        "reference_logical_artifact_id": {"type": "string", "minLength": 1},
        "implementation_logical_artifact_id": {"type": "string", "minLength": 1}
      }
    },
    "interactionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visible_actions", "no_actions_reason_ref", "required_checks", "allowed_origins", "fixture_mode", "evidence_redaction_required", "redaction_selectors"],
      "properties": {
        "visible_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action_id", "expected_outcome", "side_effect_class", "activation_policy", "outcome_assertion"],
            "properties": {
              "action_id": {"type": "string", "minLength": 1},
              "expected_outcome": {"type": "string", "minLength": 1},
              "side_effect_class": {"enum": ["none", "local_state", "navigation", "external_write", "destructive", "paid"]},
              "activation_policy": {"enum": ["execute_in_fixture", "assert_affordance_only"]},
              "outcome_assertion": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "selector", "property", "expected"],
                "properties": {
                  "kind": {"enum": ["dom", "url", "dialog", "toast", "control_state", "network_mock", "not_executed"]},
                  "selector": {"type": ["string", "null"]},
                  "property": {"type": ["string", "null"]},
                  "expected": {}
                }
              }
            }
          }
        },
        "no_actions_reason_ref": {"type": ["string", "null"]},
        "required_checks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["keyboard_activation", "focus_visibility", "tab_radio_behavior", "menus", "toggles", "refresh_feedback", "state_transitions", "no_unresolved_file_navigation", "no_console_errors", "no_request_failures", "no_page_horizontal_overflow"]}
        },
        "allowed_origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://(localhost|127\\.0\\.0\\.1|\\[::1\\]):[0-9]+/?$"}},
        "fixture_mode": {"enum": ["isolated_local", "mocked_external"]},
        "evidence_redaction_required": {"const": true},
        "redaction_selectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["product_contract", "normative_requirement", "accepted_visual", "measured_baseline", "design_token", "owner_decision", "derived_formula", "delegated_design_decision"]},
        "ref": {"type": "string", "minLength": 1},
        "locator": {"type": "string"},
        "property": {"type": "string"},
        "formula": {"type": "string"},
        "rationale": {"type": "string"},
        "constraints": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "specifiedValue": {
      "type": "object",
      "required": ["value", "origin", "change_policy"],
      "properties": {
        "value": {},
        "unit": {"type": ["string", "null"]},
        "origin": {"$ref": "#/$defs/origin"},
        "tolerance": {"type": ["number", "null"], "minimum": 0},
        "change_policy": {"enum": ["fixed", "source_revision_required", "owner_approval_required"]}
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_id", "width", "height", "class", "state_ref", "origin"],
      "properties": {
        "anchor_id": {"type": "string", "minLength": 1},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "class": {"enum": ["responsive_web", "mobile"]},
        "state_ref": {"type": "string", "minLength": 1},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "viewportContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "supported_web_width_range", "anchors", "breakpoint_policy", "breakpoint_policy_origin", "below_supported_range", "below_supported_range_origin", "above_supported_range", "above_supported_range_origin", "mobile_scope", "mobile_scope_origin", "mobile_authorization_ref", "mobile_specific_composition", "authorized_mobile_surfaces", "authorized_mobile_viewports", "allowed_mobile_changes"],
      "properties": {
        "mode": {"const": "responsive_web"},
        "supported_web_width_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_width", "max_width", "origin"],
          "properties": {
            "min_width": {"type": ["integer", "null"], "minimum": 1},
            "max_width": {"type": ["integer", "null"], "minimum": 1},
            "origin": {"$ref": "#/$defs/origin"}
          }
        },
        "anchors": {"type": "array", "items": {"$ref": "#/$defs/viewport"}},
        "breakpoint_policy": {"const": "content_driven"},
        "breakpoint_policy_origin": {"$ref": "#/$defs/origin"},
        "below_supported_range": {"enum": ["out_of_scope", "graceful_overflow", "explicit_contract"]},
        "below_supported_range_origin": {"$ref": "#/$defs/origin"},
        "above_supported_range": {"enum": ["out_of_scope", "max_content_width", "explicit_contract"]},
        "above_supported_range_origin": {"$ref": "#/$defs/origin"},
        "mobile_scope": {"enum": ["unauthorized", "authorized"]},
        "mobile_scope_origin": {"$ref": "#/$defs/origin"},
        "mobile_authorization_ref": {"type": ["string", "null"]},
        "mobile_specific_composition": {"type": "boolean"},
        "authorized_mobile_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authorized_mobile_viewports": {"type": "array", "items": {"$ref": "#/$defs/viewport"}},
        "allowed_mobile_changes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "locator", "visibility", "component_id", "component_status", "variant", "state", "source_refs", "geometry", "layout_rules", "visual_properties", "content", "interactions", "accessibility", "responsive_behavior", "geometry_tolerance_px", "geometry_tolerance_origin", "computed_style_properties", "computed_style_properties_origin"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["required", "conditional", "forbidden"]},
        "component_id": {"type": ["string", "null"]},
        "component_status": {"enum": ["registered", "candidate", "one_off", "unresolved"]},
        "variant": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/origin"}, "minItems": 1},
        "geometry": {"type": "object", "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "layout_rules": {"type": "array", "items": {"$ref": "#/$defs/specifiedValue"}},
        "visual_properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "content": {"type": "object", "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "interactions": {"type": "array", "items": {"$ref": "#/$defs/specifiedValue"}},
        "accessibility": {"type": "object", "additionalProperties": {"$ref": "#/$defs/specifiedValue"}},
        "responsive_behavior": {"type": "array", "items": {"$ref": "#/$defs/specifiedValue"}},
        "geometry_tolerance_px": {"type": "number", "minimum": 0},
        "geometry_tolerance_origin": {"$ref": "#/$defs/origin"},
        "computed_style_properties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "computed_style_properties_origin": {"$ref": "#/$defs/origin"}
      }
    },
    "productIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screen_id", "route_id", "route", "state_id", "role_id", "permission_profile", "locale", "theme"],
      "properties": {
        "screen_id": {"type": "string", "minLength": 1},
        "route_id": {"type": ["string", "null"]},
        "route": {"type": ["string", "null"]},
        "state_id": {"type": "string", "minLength": 1},
        "role_id": {"type": "string", "minLength": 1},
        "permission_profile": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "minLength": 1},
        "theme": {"type": "string", "minLength": 1}
      }
    },
    "sourceVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "html_path", "image_path", "html_sha256", "image_sha256", "owner_decision_ref"],
      "properties": {
        "kind": {"enum": ["accepted_visual", "baseline_reference", "delegated_design_output"]},
        "evidence_mode": {"enum": ["exact_screen_html", "native_image", "visual_language_only", "figma_adapter"]},
        "html_path": {"type": ["string", "null"]},
        "image_path": {"type": ["string", "null"]},
        "html_sha256": {"type": ["string", "null"]},
        "image_sha256": {"type": ["string", "null"]},
        "owner_decision_ref": {"type": ["string", "null"]},
        "delegation_ref": {"type": ["string", "null"]}
      }
    },
    "renderEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "device_scale_factor", "timezone", "fixed_clock_iso", "reduced_motion", "animations", "fixture_data_path", "fixture_data_sha256", "font_bundle_sha256", "asset_bundle_sha256"],
      "properties": {
        "browser": {"type": "string", "minLength": 1},
        "browser_mechanic": {"const": "playwright_cli"},
        "device_scale_factor": {"type": "number", "minimum": 0.1},
        "timezone": {"type": "string", "minLength": 1},
        "fixed_clock_iso": {"type": "string", "minLength": 1},
        "reduced_motion": {"const": true},
        "animations": {"const": "disabled"},
        "fixture_data_path": {"type": "string", "minLength": 1},
        "fixture_data_sha256": {"type": ["string", "null"]},
        "font_bundle_sha256": {"type": ["string", "null"]},
        "asset_bundle_sha256": {"type": ["string", "null"]}
      }
    }
  }
}
