{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/owner-input-response-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "stage_instance_id", "decision_packet_ref", "response_kind", "owner_input", "canonical_owner_decision_ref"],
  "properties": {
    "$schema": {"type": "string"},
    "program_id": {"type": "string", "minLength": 1},
    "stage_instance_id": {"type": "string", "minLength": 1},
    "decision_packet_ref": {"type": "string", "minLength": 1},
    "response_kind": {"enum": ["product_answer", "visual_acceptance", "requested_changes", "rejection"]},
    "owner_input": {"type": "string", "minLength": 1},
    "canonical_owner_decision_ref": {"type": ["string", "null"], "minLength": 1}
  }
}
