{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/stage-context-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_id", "runtime_profile", "program_id", "stage_instance_id", "gate_id", "target_id", "entries", "program_digest", "program_digest_covers", "resolved_exact_labels", "conditional_triggers", "file_count", "estimated_tokens", "limits", "status"],
  "properties": {
    "schema_id": {"const": "codex.ui-stage-context-manifest/v1"},
    "runtime_profile": {"type": "string", "minLength": 1},
    "program_id": {"type": ["string", "null"]},
    "stage_instance_id": {"type": "string", "minLength": 1},
    "gate_id": {"enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6"]},
    "target_id": {"type": "string", "minLength": 1},
    "entries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "json_pointer", "expected_identity", "reason", "conditional_trigger", "covers"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "json_pointer": {"type": ["string", "null"]}, "expected_identity": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}, "conditional_trigger": {"type": ["string", "null"]}, "covers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "program_digest": {"type": "object", "additionalProperties": false, "required": ["program_id", "revision", "contract_profile", "validation_profile", "input_contracts", "visual_authority", "execution_artifacts"], "properties": {"program_id": {"type": "string", "minLength": 1}, "revision": {"type": "integer", "minimum": 1}, "contract_profile": {"type": "string", "minLength": 1}, "validation_profile": {"type": "string", "minLength": 1}, "input_contracts": {"type": ["object", "null"]}, "visual_authority": {"type": ["object", "null"]}, "execution_artifacts": {"type": "object"}}},
    "program_digest_covers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "resolved_exact_labels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "conditional_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "file_count": {"type": "integer", "minimum": 1},
    "estimated_tokens": {"type": "integer", "minimum": 1},
    "limits": {"type": "object", "additionalProperties": false, "required": ["max_files", "target_tokens"], "properties": {"max_files": {"type": "integer", "minimum": 1}, "target_tokens": {"type": "integer", "minimum": 1}}},
    "status": {"const": "bounded"}
  }
}
