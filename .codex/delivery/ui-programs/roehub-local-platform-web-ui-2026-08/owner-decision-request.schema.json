{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/owner-decision-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_id", "decision_id", "decision_kind", "status", "revision", "decision_text", "owner_input", "target"],
  "properties": {
    "$schema": {"type": "string"},
    "program_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_kind": {"enum": ["visual_authority", "baseline_exception", "mobile_scope", "stage_acceptance", "screen_acceptance", "family_acceptance", "wave_acceptance", "program_completion"]},
    "status": {"enum": ["accepted", "rejected", "requested_changes"]},
    "revision": {"type": "integer", "minimum": 1},
    "decision_text": {"type": "string", "minLength": 1},
    "owner_input": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "minLength": 1},
    "accepted_values": {"type": "array", "items": {}},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "artifact_id", "revision", "validation_profile", "path"],
      "properties": {
        "artifact_kind": {"enum": ["program", "screen", "family_acceptance", "wave_acceptance", "baseline", "review_board"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "validation_profile": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    }
  }
}
