{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/family-acceptance-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["program_path", "family_id", "family_revision_id", "revision", "screen_acceptance_paths", "review_board_path"],
  "properties": {
    "$schema": {"type": "string"},
    "program_path": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "family_revision_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "screen_acceptance_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review_board_path": {"type": "string", "minLength": 1},
    "owner_decision_ref": {"type": ["string", "null"]}
  }
}
