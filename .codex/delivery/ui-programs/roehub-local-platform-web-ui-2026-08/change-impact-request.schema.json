{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/change-impact-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["program_id", "change_id", "change_kind", "current_stage_instance_id", "changed_refs"],
  "properties": {
    "program_id": {"type": "string", "minLength": 1},
    "change_id": {"type": "string", "minLength": 1},
    "change_kind": {"enum": ["bounded_unaccepted_visual", "accepted_family_visual", "accepted_wave_local", "g3_realization_inside_accepted_baseline", "family_wave_coverage_structure", "atlas_identity_classification", "product_semantics_scope_or_mobile", "baseline_or_visual_authority_replacement"]},
    "current_stage_instance_id": {"type": "string", "minLength": 1},
    "changed_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "description": "Path to a typed codex.ui-change-record/v1 bound to the exact anchor artifact."}}
  }
}
