      "required_assets": ["screen-design-contract.template.json", "geometry-capture.schema.json", "raster-diff.schema.json", "render-provenance-request.template.json", "render-provenance-request.schema.json", "render-provenance-receipt.template.json", "render-provenance-receipt.schema.json", "visual-qa-receipt.schema.json", "screen-acceptance.schema.json", "family-acceptance.schema.json", "family-acceptance-request.schema.json", "family-acceptance-request.template.json", "review-board-manifest.schema.json", "review-board-manifest.template.json", "owner-decision.schema.json", "owner-decision-request.schema.json", "owner-decision-request.template.json", "stage-transition-request.template.json", "stage-transition-request.schema.json", "stage-transition-readiness.template.json", "stage-transition-readiness.schema.json"],
      "required_commands": ["python3 scripts/ui_design_tool.py preflight", "python3 scripts/ui_design_tool.py capture -- --url <loopback-url> --contract <screen-contract> --anchor-id <anchor-id> --target <reference|implementation> --source-artifact <rendered-source-artifact> --logical-artifact-id <logical-id> --output <geometry-receipt> --screenshot <redacted-png>", "python3 scripts/assemble_render_provenance.py --request <render-provenance-request.json> --project-root <root> --output <render-provenance-receipt>", "python3 scripts/ui_design_tool.py compare -- --reference <reference-png> --implementation <implementation-png> --output <raster-receipt> --screen-revision-id <screen-revision-id> --anchor-id <anchor-id> --comparison-purpose <purpose> --reference-logical-artifact-id <reference-id> --implementation-logical-artifact-id <implementation-id> --visual-authority-ref <authority-path> --visual-authority-sha256 <authority-sha256> --reference-render-provenance <reference-render-provenance> --implementation-render-provenance <implementation-render-provenance> --project-root <root>", "python3 scripts/assemble_visual_qa_receipt.py --contract <screen-contract> --reference-geometry <reference-geometry> --implementation-geometry <implementation-geometry> --raster-receipt <raster-receipt> --output <visual-qa-receipt>", "python3 scripts/assemble_screen_acceptance.py --contract <screen-contract> --anchor-receipt <visual-qa-receipt repeated> --output <screen-acceptance>", "python3 scripts/assemble_family_acceptance.py --request <family-acceptance-request.json> --project-root <root> --output <family-acceptance>", "python3 scripts/assemble_owner_decision.py --request <owner-decision-request.json> --project-root <root> --output <owner-decision>", "python3 scripts/assemble_stage_transition.py --request <stage-transition-request.json> --project-root <root> --ledger <stage-ledger> --output <transition-receipt>"],
