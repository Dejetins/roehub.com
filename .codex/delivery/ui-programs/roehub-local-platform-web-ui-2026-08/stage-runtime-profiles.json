      "read_set": {"always": ["current ledger row", "visual-authority block"], "exact": ["full platform baseline", "G3 rendered-proof section", "family shard index", "representative shell source slice"], "conditional": ["source adapter contract selected by source_evidence_mode"], "max_files": 8, "target_tokens": 50000},
      "required_assets": ["screen-design-contract.template.json", "screen-design-contract.schema.json", "render-provenance-request.template.json", "render-provenance-request.schema.json", "render-provenance-receipt.template.json", "render-provenance-receipt.schema.json", "review-board-manifest.schema.json", "review-board-manifest.template.json", "owner-decision.schema.json", "owner-decision-request.schema.json", "owner-decision-request.template.json", "proposal-for-owner-review.template.md", "stage-transition-request.template.json", "stage-transition-request.schema.json", "stage-transition-readiness.template.json", "stage-transition-readiness.schema.json"],
      "required_commands": ["python3 scripts/ui_design_tool.py preflight", "python3 scripts/ui_design_tool.py capture -- --url <loopback-url> --contract <screen-contract> --anchor-id <anchor-id> --target <reference|implementation> --source-artifact <rendered-source-artifact> --logical-artifact-id <logical-id> --output <geometry-receipt> --screenshot <redacted-png>", "python3 scripts/assemble_render_provenance.py --request <render-provenance-request.json> --project-root <root> --output <render-provenance-receipt>", "python3 scripts/ui_design_tool.py compare -- --reference <reference-png> --implementation <implementation-png> --output <raster-receipt> --screen-revision-id <screen-revision-id> --anchor-id <anchor-id> --comparison-purpose <purpose> --reference-logical-artifact-id <reference-id> --implementation-logical-artifact-id <implementation-id> --visual-authority-ref <authority-path> --visual-authority-sha256 <authority-sha256> --reference-render-provenance <reference-render-provenance> --implementation-render-provenance <implementation-render-provenance> --project-root <root>", "python3 scripts/assemble_owner_decision.py --request <owner-decision-request.json> --project-root <root> --output <owner-decision>", "python3 scripts/assemble_stage_transition.py --request <stage-transition-request.json> --project-root <root> --ledger <stage-ledger> --output <transition-receipt>"],
      "required_validators": ["python3 scripts/validate_ui_design_program.py --profile screen_contract_ready --project-root <root> <representative-shell-screen-contract>", "python3 scripts/validate_ui_design_program.py --profile program_ready --project-root <root> <program>", "python3 scripts/validate_stage_ledger.py --project-root <root> <stage-ledger>", "python3 scripts/validate_stage_transition.py --project-root <root> --ledger <stage-ledger> <transition-receipt>"],
      "companion_skills": ["browser-qa-evidence with playwright-cli for canonical captures"],
      "owner_gate": {"required": true, "review_profile": "program_ready", "decision_kind": "stage_acceptance"},
      "owner_review_surface": "Finished shell/foundations and responsive endpoint review board; the agent records the answer.",
