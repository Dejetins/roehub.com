      "next_gates": ["G4"],
      "completion_behavior": {"transition_kind": "advance", "next_stage_allowed": true, "program_complete": false},
      "next_preflight": ["every representative family has its exact functional and visual inputs", "G4 prompt exists with no known stop trap"]
    },
    "G4": {
      "title": "Representative family",
      "artifact_kind": "family_acceptance",
      "validation_profile": "family_gate",
