{
  "$schema": "stage-runtime-profiles.schema.json",
  "schema_id": "codex.ui-stage-runtime-profiles/v1",
  "version": "1.6.0",
  "core": {
    "contract_registry": "assets/contract-versions.json",
    "control_plane": ["plan_doc", "prompt_pack_dir", "stage_ledger"],
    "control_assets": ["stage-preflight-evidence.template.json", "stage-preflight-evidence.schema.json", "owner-input-response.template.json", "owner-input-response.schema.json", "owner-input-response-request.schema.json", "change-impact-matrix.json", "change-impact-matrix.schema.json", "change-record.template.json", "change-record.schema.json", "change-impact-request.schema.json", "change-impact-receipt.schema.json", "stage-context-manifest.schema.json"],
    "control_commands": ["python3 scripts/ui_program_context.py --ledger <stage-ledger> --project-root <root>", "python3 scripts/assemble_owner_input_response.py --request <owner-response-request.json> --project-root <root> --ledger <stage-ledger> --output <owner-response>", "python3 scripts/assemble_change_impact.py --request <change-impact-request.json> --project-root <root> --ledger <stage-ledger> --output <impact-receipt>"],
    "input_contracts": ["ui-program-intake", "platform-ui-baseline"],
    "visual_authority_fields": ["source_visual_ref", "source_visual_sha256", "source_evidence_mode", "owner_decision_ref", "screen_acceptance_scope", "visual_language_scope", "reusable_foundation_scope", "inheritance_policy", "mobile_scope"],
    "decision_classes": {
      "agent_decidable": "Resolve reversible technical and presentation choices inside the accepted product and visual envelope; generate paths, hashes, receipts, ledgers, and routine writes without asking the user.",
      "owner_required": "Ask only for missing product meaning or scope, new mobile scope, materially different visual direction, irreversible or costly choices, and acceptance or correction of a finished visual result.",
      "external_authority": "Use an already-authorized repository route; hard-block only when a required permission or external state is genuinely unavailable."
    },
    "user_role_policy": [
      "The user's initial brief and later corrections are the sole authority for desired product meaning; repository sources are current-state evidence, not a second product owner.",
      "The user describes the desired product path once with the agent; the agent records and carries that durable intent baseline through the program.",
      "The user reviews finished visuals and corrects material product or visual mistakes.",
      "Never ask the user to calculate hashes, name technical artifact owners, edit JSON, operate the ledger, choose routine tools, or repeat ordinary write permission already granted by the task.",
      "The agent records natural-language decisions as canonical receipts and owns routine program coordination."
    ],
    "owner_surface": [
      "Lead with the stage's declared owner surface; use finished visuals or one compact review board only for G3-G6.",
      "Show material exceptions and at most three questions.",
      "Keep raw JSON, inventories, hashes, permissions, and validator logs in linked evidence.",
      "Accept unambiguous natural-language decisions; never require identifiers or magic syntax."
    ],
    "invariants": [
      "A component catalog never substitutes for the all-screen atlas.",
      "Desired product semantics come from the initial user brief and later user corrections; current product sources constrain factual compatibility but cannot silently redefine intent.",
      "Generated views and passing receipts are assembled by scripts, not hand-edited.",
      "Agent self-acceptance is prohibited; machine review readiness and user acceptance are separate states.",
      "Responsive Web is required; mobile-specific product scope requires explicit current user authorization.",
      "Current-gate success alone never permits the adjacent stage.",
      "Historical contract profiles are read-only and cannot close active gates.",
      "Determinism, source fidelity, native-image comparison, and visual-language conformance are separate claims."
    ],
    "preflight_checks": ["current_gate", "source_freshness", "next_stage_inputs", "write_scope", "foreign_changes", "execution_route", "handoff_artifact"],
    "state_policy": {
      "review_ready": "Machine evidence is complete and the finished result may be shown to the user; the stage remains non-terminal until the user accepts or requests a bounded revision.",
      "needs_input": "Ledger-only non-terminal state for a material product question or finished-result review; resume the same row from typed owner-response evidence.",
      "blocked": "Terminal only for authority, safety, evidence, permission, inseparable foreign change, or unavailable external state.",
      "revision": "Create a replacement only when target, scope, dependencies, accepted sources, prompt requirements, or acceptance criteria materially change."
    }
  },
  "stages": {
    "G0": {
      "title": "Authoritative sources",
      "artifact_kind": "program",
      "validation_profile": "draft",
      "objective": "Resolve the complete product intake, accepted pilot identity, immutable platform baseline, program-owned paths, and draft execution triad without asking the user for technical bookkeeping.",
      "owns": ["source classification", "complete intake", "screen/state/action contracts", "pilot incorporation", "platform baseline", "draft triad bootstrap"],
      "required_outputs": ["intake_ready intake", "baseline_ready baseline", "active-profile draft manifest", "draft prompt-pack triad", "decision packet only for non-derivable product meaning"],
      "allowed_unresolved": ["later-gate design and implementation evidence"],
      "forbidden": ["design work", "historical active authority", "placeholder baseline", "asking the user to edit JSON, compute hashes, name technical owners, or reauthorize routine writes"],
      "required_references": ["references/intake-baseline-contract-v1.md"],
      "read_set": {"always": ["current AGENTS.md chain", "initial user brief", "program manifest identity"], "exact": ["complete product-source index", "accepted pilot", "intake and baseline artifacts"], "conditional": ["product-design:index only when no accepted visual direction exists before G0"], "max_files": 8, "target_tokens": 45000},
      "required_assets": ["ui-program-intake.template.json", "platform-ui-baseline.template.json", "ui-design-program.template.json", "program-artifact-index.template.json", "program-artifact-index.schema.json", "stage-prompt-template.md", "stage-ledger-template.md", "stage-transition-request.template.json", "stage-transition-request.schema.json", "stage-transition-readiness.template.json", "stage-transition-readiness.schema.json"],
      "required_commands": ["python3 scripts/init_ui_design_program.py --output-dir <program-dir> --program-id <id> --program-name <name> --product <product>", "python3 scripts/ui_program_intake.py --project-root <root> --intake <intake>", "python3 scripts/assemble_stage_transition.py --request <stage-transition-request.json> --project-root <root> --ledger <stage-ledger> --output <transition-receipt>"],
      "required_validators": ["python3 scripts/validate_ui_design_program.py --profile intake_ready --project-root <root> <intake>", "python3 scripts/validate_ui_design_program.py --profile baseline_ready --project-root <root> <baseline>", "python3 scripts/validate_ui_design_program.py --profile draft --project-root <root> <program>", "python3 scripts/validate_stage_ledger.py --project-root <root> <stage-ledger>", "python3 scripts/validate_stage_transition.py --project-root <root> --ledger <stage-ledger> <transition-receipt>"],
      "companion_skills": ["prompt-manager for draft triad creation before first G0 claim"],
      "owner_gate": {"required": false, "review_profile": null, "decision_kind": null},
      "owner_review_surface": "A concise product/baseline summary and only genuinely missing product questions.",
      "requires_visual_authority_context": true,
      "next_gates": ["G1"],
      "completion_behavior": {"transition_kind": "advance", "next_stage_allowed": true, "program_complete": false},
      "next_preflight": ["intake and baseline are ready and hash-current", "draft triad exists and is cross-linked", "screen and journey collections exact-cover their sources", "program-owned paths are known"]
    },
    "G1": {
      "title": "Complete all-screen atlas",
      "artifact_kind": "program",
      "validation_profile": "atlas_gate",
      "objective": "Represent every authoritative screen, state surface, overlay, shell, internal surface, and exclusion exactly once.",
      "owns": ["screen identity", "classification", "disposition", "functional binding", "shell binding"],
      "required_outputs": ["reconciled manifest", "generated all-screen atlas", "counts and material exceptions"],
      "allowed_unresolved": ["G2 graph, family, wave, and coverage fields", "later visual evidence"],
      "forbidden": ["component catalog as atlas", "silent omission", "invented screen", "visual direction work"],
      "required_references": [],
      "read_set": {"always": ["current ledger row", "program identity digest"], "exact": ["screen shard index", "journey shard index", "shell exception slice"], "conditional": ["individual screen functional contract only when reconciliation fails"], "max_files": 8, "target_tokens": 40000},
      "required_assets": ["ui-design-program.schema.json", "screen-atlas.schema.json", "stage-transition-request.template.json", "stage-transition-request.schema.json", "stage-transition-readiness.template.json", "stage-transition-readiness.schema.json"],
      "required_commands": ["python3 scripts/render_screen_atlas.py --program <program> --project-root <root> --output <atlas> --resolved-json <atlas-json>", "python3 scripts/assemble_stage_transition.py --request <stage-transition-request.json> --project-root <root> --ledger <stage-ledger> --output <transition-receipt>"],
      "required_validators": ["python3 scripts/validate_ui_design_program.py --profile atlas_gate --project-root <root> <program>", "python3 scripts/validate_stage_ledger.py --project-root <root> <stage-ledger>", "python3 scripts/validate_stage_transition.py --project-root <root> --ledger <stage-ledger> <transition-receipt>"],
      "companion_skills": [],
      "owner_gate": {"required": false, "review_profile": null, "decision_kind": null},
      "owner_review_surface": "Rendered atlas counts and material product-completeness exceptions only.",
      "requires_visual_authority_context": false,
      "next_gates": ["G2"],
      "completion_behavior": {"transition_kind": "advance", "next_stage_allowed": true, "program_complete": false},
      "next_preflight": ["G2 graph requirements dry-run", "entry, terminal, failure, and recovery semantics are known"]
    },
    "G2": {
      "title": "Journeys, families, coverage, and waves",
      "artifact_kind": "program",
      "validation_profile": "structure_gate",
      "objective": "Complete journey graphs, criticality, families, representatives, coverage, waves, workload budgets, and exact platform-baseline inheritance.",
      "owns": ["journey graph and criticality", "family membership", "representatives", "coverage", "waves and workload budgets"],
      "required_outputs": ["source-backed journey graphs", "critical journey classification", "families and coverage profiles", "bounded waves", "exact baseline binding per family"],
      "allowed_unresolved": ["viewport_anchor_ids only, using the emitted normative origin"],
      "forbidden": ["bulk screen generation", "false reuse", "guessed responsive anchors", "fabricated transition"],
      "required_references": ["references/stage-profiles-v1.md#g2-journeys-and-families"],
      "read_set": {"always": ["current ledger row", "program visual-authority digest"], "exact": ["journey shard index", "screen shard index", "family shard index and coverage section", "platform baseline identity"], "conditional": ["screen functional contract only for unresolved graph or family membership"], "max_files": 8, "target_tokens": 45000},
      "required_assets": ["ui-design-program.schema.json", "program-artifact-index.schema.json", "stage-transition-request.template.json", "stage-transition-request.schema.json", "stage-transition-readiness.template.json", "stage-transition-readiness.schema.json"],
      "required_commands": ["python3 scripts/render_screen_atlas.py --program <program> --project-root <root> --output <atlas> --resolved-json <atlas-json>", "python3 scripts/assemble_stage_transition.py --request <stage-transition-request.json> --project-root <root> --ledger <stage-ledger> --output <transition-receipt>"],
      "required_validators": ["python3 scripts/validate_ui_design_program.py --profile structure_gate --project-root <root> <program>", "python3 scripts/validate_stage_ledger.py --project-root <root> <stage-ledger>", "python3 scripts/validate_stage_transition.py --project-root <root> --ledger <stage-ledger> <transition-receipt>"],
      "companion_skills": [],
      "owner_gate": {"required": false, "review_profile": null, "decision_kind": null},
      "owner_review_surface": "Journey/family/wave summary and only unresolved product meaning.",
      "requires_visual_authority_context": true,
      "next_gates": ["G3"],
      "completion_behavior": {"transition_kind": "advance", "next_stage_allowed": true, "program_complete": false},
      "next_preflight": ["all non-viewport coverage dimensions are resolved", "the exact platform baseline remains current", "viewport_anchor_ids is the only documented deferral"]
