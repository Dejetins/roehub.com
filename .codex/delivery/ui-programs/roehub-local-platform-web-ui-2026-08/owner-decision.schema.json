{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/owner-decision.schema.json",
  "title": "Canonical owner decision recorded by the agent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "generated_by", "program_id", "decision_id", "decision_kind", "target", "decision", "recording"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-owner-decision/v1"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "version", "command"],
      "properties": {
        "script": {"const": "assemble_owner_decision.py"},
        "version": {"const": "1.0.0"},
        "command": {"const": "assemble_owner_decision.py <paths-redacted>"}
      }
    },
    "program_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "decision_kind": {
      "enum": ["visual_authority", "baseline_exception", "mobile_scope", "stage_acceptance", "screen_acceptance", "family_acceptance", "wave_acceptance", "program_completion"]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "artifact_id", "revision", "validation_profile", "path", "sha256"],
      "properties": {
        "artifact_kind": {"enum": ["program", "screen", "family_acceptance", "wave_acceptance", "baseline", "review_board"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "validation_profile": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revision", "decision_text", "accepted_values", "accepted_value_sha256s"],
      "properties": {
        "status": {"enum": ["accepted", "rejected", "requested_changes"]},
        "revision": {"type": "integer", "minimum": 1},
        "decision_text": {"type": "string", "minLength": 1},
        "accepted_values": {"type": "array"},
        "accepted_value_sha256s": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "owner_input", "recorded_by", "recorded_at"],
      "properties": {
        "source": {"const": "natural_language_owner_input"},
        "owner_input": {"type": "string", "minLength": 1},
        "recorded_by": {"const": "agent"},
        "recorded_at": {"type": "string", "minLength": 1}
      }
    }
  }
}
