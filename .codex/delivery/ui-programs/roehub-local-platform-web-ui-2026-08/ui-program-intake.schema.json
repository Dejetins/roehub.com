{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/skills/ui-design-program/ui-program-intake.schema.json",
  "title": "Complete product and screen-function intake for a UI design program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "contract_profile", "intake_id", "revision", "status",
    "product", "program_scope", "authoritative_inventory", "source_contracts",
    "roles", "permission_profiles", "locales", "themes",
    "global_data_contracts", "journeys", "screens", "pilot",
    "accepted_decisions", "baseline_contract", "unresolved_inputs"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_id": {"const": "codex.ui-program-intake/v1"},
    "contract_profile": {"const": "codex.ui-program-intake/v1@1.0.0"},
    "intake_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "complete", "superseded"]},
    "product": {"$ref": "#/$defs/product"},
    "program_scope": {"$ref": "#/$defs/programScope"},
    "authoritative_inventory": {"$ref": "#/$defs/authoritativeInventory"},
    "source_contracts": {"type": "array", "items": {"$ref": "#/$defs/sourceContract"}},
    "roles": {"type": "array", "items": {"$ref": "#/$defs/namedSourceItem"}},
    "permission_profiles": {"type": "array", "items": {"$ref": "#/$defs/namedSourceItem"}},
    "locales": {"type": "array", "items": {"$ref": "#/$defs/namedSourceItem"}},
    "themes": {"type": "array", "items": {"$ref": "#/$defs/namedSourceItem"}},
    "global_data_contracts": {"type": "array", "items": {"$ref": "#/$defs/dataContract"}},
    "journeys": {"type": "array", "items": {"$ref": "#/$defs/journey"}},
    "screens": {"type": "array", "items": {"$ref": "#/$defs/screen"}},
    "pilot": {"$ref": "#/$defs/pilot"},
    "accepted_decisions": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
    "baseline_contract": {"$ref": "#/$defs/baselineRef"},
    "unresolved_inputs": {"type": "array", "items": {"$ref": "#/$defs/unresolvedInput"}}
  },
  "$defs": {
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "collectionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json_pointer", "id_key"],
      "properties": {
        "json_pointer": {"type": "string", "pattern": "^/"},
        "id_key": {"type": "string", "minLength": 1}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_id", "product_name", "purpose", "operating_model",
        "primary_user_outcomes", "domain_entities", "domain_terms",
        "supported_platforms"
      ],
      "properties": {
        "product_id": {"type": "string", "minLength": 1},
        "product_name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "operating_model": {"type": "string", "minLength": 1},
        "primary_user_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "domain_entities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "domain_terms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "supported_platforms": {"type": "array", "items": {"enum": ["web"]}, "minItems": 1, "uniqueItems": true}
      }
    },
    "programScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_release_slices", "excluded_release_slices", "public_site_in_scope", "mobile_scope", "source_ref"],
      "properties": {
        "included_release_slices": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "excluded_release_slices": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "public_site_in_scope": {"type": "boolean"},
        "mobile_scope": {"enum": ["unauthorized", "authorized"]},
        "source_ref": {"$ref": "#/$defs/sourceRef"}
      }
    },
    "authoritativeInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "screen_collection", "journey_collection"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "screen_collection": {"$ref": "#/$defs/collectionRef"},
        "journey_collection": {"$ref": "#/$defs/collectionRef"}
      }
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "authority", "covers"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "authority": {"type": "string", "minLength": 1},
        "covers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["product", "routes", "screens", "journeys", "roles", "permissions", "states", "data", "copy", "locales", "themes", "assets", "runtime"]}}
      }
    },
    "namedSourceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning", "source_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
      }
    },
    "dataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_id", "meaning", "freshness", "source_refs"],
      "properties": {
        "data_id": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "freshness": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
      }
    },
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_id", "purpose", "role_ids", "preconditions", "entry_screen_ids", "terminal_screen_ids", "outcomes", "transitions", "source_refs"],
      "properties": {
        "journey_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "role_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "entry_screen_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "terminal_screen_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transition_id", "from_screen_id", "action_id", "to_screen_id", "external_boundary", "outcome", "failure", "recovery", "source_refs"],
            "properties": {
              "transition_id": {"type": "string", "minLength": 1},
              "from_screen_id": {"type": "string", "minLength": 1},
              "action_id": {"type": "string", "minLength": 1},
              "to_screen_id": {"type": ["string", "null"]},
              "external_boundary": {"type": ["string", "null"]},
              "outcome": {"type": "string", "minLength": 1},
              "failure": {"type": "string", "minLength": 1},
              "recovery": {"type": "string", "minLength": 1},
              "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
            }
          }
        },
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
      }
    },
    "screenData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reads", "writes", "computed", "refresh_behavior", "freshness_behavior", "empty_data_meaning"],
      "properties": {
        "reads": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "writes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "computed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "refresh_behavior": {"type": "string", "minLength": 1},
        "freshness_behavior": {"type": "string", "minLength": 1},
        "empty_data_meaning": {"type": "string", "minLength": 1}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region_id", "purpose", "content", "data_refs", "state_ids", "action_ids", "source_refs"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "data_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "state_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "action_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
      }
    },
    "screenState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "kind", "trigger", "visible_region_ids", "available_action_ids", "exit_conditions", "source_refs"],
      "properties": {
        "state_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["initial", "loading", "populated", "empty", "partial", "error", "permission_denied", "offline", "recovery", "terminal", "other"]},
        "trigger": {"type": "string", "minLength": 1},
        "visible_region_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "available_action_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exit_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "control_type", "component_id", "component_variant", "size_class", "label", "icon_id", "region_id", "intent",
        "visibility", "enabled_when", "preconditions", "trigger", "outcome",
        "feedback", "failure", "recovery", "confirmation", "side_effects",
        "destructive", "permission_refs", "keyboard", "navigation_target",
        "opens_surface_id", "source_refs"
      ],
      "properties": {
        "action_id": {"type": "string", "minLength": 1},
        "control_type": {"enum": ["button", "icon_button", "link", "tab", "menu_item", "toggle", "checkbox", "radio", "select", "input_submit", "row_action", "sort", "filter", "pagination", "refresh", "retry", "drag_handle", "resize_handle", "keyboard_command", "other"]},
        "component_id": {"type": ["string", "null"]},
        "component_variant": {"type": ["string", "null"]},
        "size_class": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "icon_id": {"type": ["string", "null"]},
        "region_id": {"type": "string", "minLength": 1},
        "intent": {"type": "string", "minLength": 1},
        "visibility": {"type": "string", "minLength": 1},
        "enabled_when": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "trigger": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "feedback": {"type": "string", "minLength": 1},
        "failure": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "confirmation": {"type": "string", "minLength": 1},
        "side_effects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "destructive": {"type": "boolean"},
        "permission_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "keyboard": {"type": "string", "minLength": 1},
        "navigation_target": {"type": ["string", "null"]},
        "opens_surface_id": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
      }
    },
    "contextMenu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["menu_id", "trigger_action_id", "item_action_ids", "placement", "dismissal", "keyboard", "source_refs"],
      "properties": {
        "menu_id": {"type": "string", "minLength": 1},
        "trigger_action_id": {"type": "string", "minLength": 1},
        "item_action_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "placement": {"type": "string", "minLength": 1},
        "dismissal": {"type": "string", "minLength": 1},
        "keyboard": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true}
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "screen_id", "page_id", "route_id", "route", "surface_kind",
        "visual_surface", "shell_variant_id", "purpose", "user_outcomes",
        "entry_points", "exit_points", "source_refs", "data", "role_ids",
        "permission_behavior", "regions", "states", "state_applicability", "actions", "context_menus",
        "related_surface_ids", "no_actions_reason", "accessibility_contract",
        "responsive_content_priorities"
      ],
      "properties": {
        "screen_id": {"type": "string", "minLength": 1},
        "page_id": {"type": ["string", "null"]},
        "route_id": {"type": ["string", "null"]},
        "route": {"type": ["string", "null"]},
        "surface_kind": {"enum": ["route_screen", "route_flow", "persistent_shell", "route_backed_transient", "overlay", "system_state_family", "internal_or_non_visual", "historical_exclusion"]},
        "visual_surface": {"type": "boolean"},
        "shell_variant_id": {"type": ["string", "null"]},
        "purpose": {"type": "string", "minLength": 1},
        "user_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "entry_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exit_points": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true},
        "data": {"$ref": "#/$defs/screenData"},
        "role_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "permission_behavior": {"type": "string", "minLength": 1},
        "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
        "states": {"type": "array", "items": {"$ref": "#/$defs/screenState"}},
        "state_applicability": {
          "type": "array",
          "minItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "mode", "reason_ref"],
            "properties": {
              "kind": {"enum": ["initial", "loading", "populated", "empty", "partial", "error", "permission_denied", "offline", "recovery", "terminal", "other"]},
              "mode": {"enum": ["required", "not_applicable"]},
              "reason_ref": {"type": ["string", "null"]}
            }
          }
        },
        "actions": {"type": "array", "items": {"$ref": "#/$defs/action"}},
        "context_menus": {"type": "array", "items": {"$ref": "#/$defs/contextMenu"}},
        "related_surface_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "no_actions_reason": {"type": ["string", "null"]},
        "accessibility_contract": {"type": "string", "minLength": 1},
        "responsive_content_priorities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_visual_ref", "source_visual_sha256", "source_evidence_mode", "owner_decision_ref",
        "native_viewport", "reviewed_state_ids", "reviewed_theme_ids",
        "represented_screen_ids", "screen_acceptance_scope",
        "visual_language_scope", "reusable_foundation_scope",
        "inheritance_policy"
      ],
      "properties": {
        "source_visual_ref": {"type": "string", "minLength": 1},
        "source_visual_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_evidence_mode": {"enum": ["renderable_html", "native_image", "figma_adapter"]},
        "owner_decision_ref": {"type": "string", "minLength": 1},
        "native_viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          }
        },
        "reviewed_state_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "reviewed_theme_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "represented_screen_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "screen_acceptance_scope": {"type": "string", "minLength": 1},
        "visual_language_scope": {"type": "string", "minLength": 1},
        "reusable_foundation_scope": {"type": "string", "minLength": 1},
        "inheritance_policy": {"enum": ["required", "explicit_exception"]}
      }
    },
    "baselineRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "path", "sha256"],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "unresolvedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_id", "path", "decision_class", "question", "why_needed", "recommended_answer"],
      "properties": {
        "input_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "decision_class": {"enum": ["agent_decidable", "owner_required", "external_authority"]},
        "question": {"type": "string", "minLength": 1},
        "why_needed": {"type": "string", "minLength": 1},
        "recommended_answer": {"type": "string", "minLength": 1}
      }
    }
  }
}
