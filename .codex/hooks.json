{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/roehub_hook_router.py\"",
            "timeout": 20,
            "statusMessage": "Checking Roehub pre-tool policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/roehub_hook_router.py\"",
            "timeout": 20,
            "statusMessage": "Reviewing Roehub post-tool evidence"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/roehub_hook_router.py\"",
            "timeout": 20,
            "statusMessage": "Checking Roehub completion gates"
          }
        ]
      }
    ]
  }
}
