# Roehub Codex execpolicy layer.
#
# This is a conservative command-prefix layer, not the only enforcement boundary.
# Hook validators still inspect shell wrapper contents and SSH command strings.

prefix_rule(
    pattern = ["git", "-C", "/opt/roehub/app"],
    decision = "forbidden",
    justification = "Use `git -C /Users/daniildegtyarev/Projects/roehub.com ...`; `/opt/roehub/app` is runtime rsync state, not the git checkout.",
    match = [
        "git -C /opt/roehub/app status",
        "git -C /opt/roehub/app pull --ff-only origin main",
        "git -C /opt/roehub/app reset --hard",
    ],
    not_match = [
        "git -C /Users/daniildegtyarev/Projects/roehub.com status",
        "rsync -a /Users/daniildegtyarev/Projects/roehub.com/ /opt/roehub/app/",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Destructive git reset is blocked unless the user explicitly asks for a recovery operation with a narrow command.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD",
    ],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Git clean can delete untracked work; use a narrow explicit removal command only after user approval.",
    match = [
        "git clean -fd",
        "git clean -fdx",
    ],
)

prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-push is blocked by default. Ask the user explicitly and prefer --force-with-lease if a rewrite is truly intended.",
    match = [
        "git push --force",
        "git push --force origin feature",
    ],
)
