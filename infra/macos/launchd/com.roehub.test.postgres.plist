<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roehub.test.postgres</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>mkdir -p /opt/roehub/test/postgresql; if [ ! -s /opt/roehub/test/postgresql/PG_VERSION ]; then /opt/homebrew/opt/postgresql@16/bin/initdb -D /opt/roehub/test/postgresql; fi; exec /opt/homebrew/opt/postgresql@16/bin/postgres -D /opt/roehub/test/postgresql -h 127.0.0.1 -p 15433</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/test-postgres.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/test-postgres.err.log</string>
</dict>
</plist>
