<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roehub.redis-exporter</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source /Users/daniildegtyarev/.config/roehub/roehub.env; set +a; export REDIS_ADDR=${REDIS_EXPORTER_ADDR:-redis://127.0.0.1:6379}; export REDIS_PASSWORD=${REDIS_EXPORTER_PASSWORD:-${ROEHUB_REDIS_PASSWORD:-}}; exec /opt/roehub/bin/redis_exporter --web.listen-address=127.0.0.1:9121</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/redis-exporter.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/redis-exporter.err.log</string>
</dict>
</plist>
