<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roehub.openbao</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>WorkingDirectory</key>
  <string>/opt/roehub</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin; exec /opt/homebrew/opt/openbao/bin/bao server -config=/opt/roehub/config/openbao/openbao.prod.hcl</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/openbao.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/openbao.err.log</string>
</dict>
</plist>
