<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roehub.lmstudio-backtest-ai-runtime</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>WorkingDirectory</key>
  <string>/opt/roehub/app</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin; cd /opt/roehub/app; exec /opt/roehub/app/scripts/macos/ensure_lmstudio_backtest_ai_runtime.sh --config /opt/roehub/app/configs/prod/backtest_ai_configurator.yaml --json</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/lmstudio-backtest-ai-runtime.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/lmstudio-backtest-ai-runtime.err.log</string>
</dict>
</plist>
