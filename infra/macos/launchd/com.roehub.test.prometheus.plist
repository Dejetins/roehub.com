<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.roehub.test.prometheus</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>mkdir -p /opt/roehub/test/prometheus; exec /opt/homebrew/bin/prometheus --config.file=/opt/roehub/config/prometheus.test.yml --storage.tsdb.path=/opt/roehub/test/prometheus --storage.tsdb.retention.time=30d --web.listen-address=127.0.0.1:19090</string>
  </array>

  <key>StandardOutPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/test-prometheus.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/daniildegtyarev/Library/Logs/roehub/test-prometheus.err.log</string>
</dict>
</plist>
