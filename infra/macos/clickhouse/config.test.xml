<clickhouse>
  <logger>
    <level>information</level>
    <log>/opt/roehub/test/clickhouse/logs/clickhouse-server.log</log>
    <errorlog>/opt/roehub/test/clickhouse/logs/clickhouse-server.err.log</errorlog>
    <console>false</console>
  </logger>

  <http_port>18124</http_port>
  <tcp_port>19001</tcp_port>
  <listen_host>127.0.0.1</listen_host>

  <path>/opt/roehub/test/clickhouse/data/</path>
  <tmp_path>/opt/roehub/test/clickhouse/tmp/</tmp_path>
  <user_files_path>/opt/roehub/test/clickhouse/user_files/</user_files_path>
  <format_schema_path>/opt/roehub/test/clickhouse/format_schemas/</format_schema_path>
  <access_control_path>/opt/roehub/test/clickhouse/access/</access_control_path>

  <user_directories>
    <users_xml>
      <path>/opt/roehub/config/clickhouse.users.roehub.xml</path>
    </users_xml>
    <local_directory>
      <path>/opt/roehub/test/clickhouse/access/</path>
    </local_directory>
  </user_directories>

  <profiles>
    <default>
      <max_memory_usage>4000000000</max_memory_usage>
      <load_balancing>random</load_balancing>
    </default>
  </profiles>

  <quotas>
    <default>
      <interval>
        <duration>3600</duration>
        <queries>0</queries>
        <errors>0</errors>
        <result_rows>0</result_rows>
        <read_rows>0</read_rows>
        <execution_time>0</execution_time>
      </interval>
    </default>
  </quotas>
</clickhouse>
