<clickhouse>
  <logger>
    <level>information</level>
    <log>/opt/roehub/clickhouse/logs/clickhouse-server.log</log>
    <errorlog>/opt/roehub/clickhouse/logs/clickhouse-server.err.log</errorlog>
    <console>false</console>
  </logger>

  <http_port>8123</http_port>
  <tcp_port>9000</tcp_port>
  <listen_host>127.0.0.1</listen_host>

  <mark_cache_size>268435456</mark_cache_size>
  <uncompressed_cache_size>0</uncompressed_cache_size>

  <background_schedule_pool_size>64</background_schedule_pool_size>
  <background_pool_size>8</background_pool_size>
  <background_merges_mutations_concurrency_ratio>4</background_merges_mutations_concurrency_ratio>

  <max_server_memory_usage_to_ram_ratio>0.65</max_server_memory_usage_to_ram_ratio>

  <path>/opt/roehub/clickhouse/data/</path>
  <tmp_path>/opt/roehub/clickhouse/tmp/</tmp_path>
  <user_files_path>/opt/roehub/clickhouse/user_files/</user_files_path>
  <format_schema_path>/opt/roehub/clickhouse/format_schemas/</format_schema_path>
  <access_control_path>/opt/roehub/clickhouse/access/</access_control_path>

  <user_directories>
    <users_xml>
      <path>/opt/roehub/config/clickhouse.users.roehub.xml</path>
    </users_xml>
    <local_directory>
      <path>/opt/roehub/clickhouse/access/</path>
    </local_directory>
  </user_directories>

  <profiles>
    <default>
      <max_memory_usage>4000000000</max_memory_usage>
      <max_threads>6</max_threads>
      <max_bytes_before_external_group_by>536870912</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>536870912</max_bytes_before_external_sort>
      <use_uncompressed_cache>0</use_uncompressed_cache>
      <use_query_cache>0</use_query_cache>
      <load_balancing>random</load_balancing>
    </default>
    <export_high_throughput>
      <max_memory_usage>24000000000</max_memory_usage>
      <max_threads>12</max_threads>
      <max_bytes_before_external_group_by>2147483648</max_bytes_before_external_group_by>
      <max_bytes_before_external_sort>2147483648</max_bytes_before_external_sort>
      <use_uncompressed_cache>0</use_uncompressed_cache>
      <use_query_cache>0</use_query_cache>
      <load_balancing>random</load_balancing>
    </export_high_throughput>
  </profiles>

  <quotas>
    <default>
      <interval>
        <duration>3600</duration>
        <queries>0</queries>
        <errors>0</errors>
        <result_rows>0</result_rows>
        <read_rows>0</read_rows>
        <execution_time>0</execution_time>
      </interval>
    </default>
  </quotas>
</clickhouse>
