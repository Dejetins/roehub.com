# Install this host-local block in ~/.ssh/config and replace placeholders.
# Never commit the real host address or private-key path.
Host roehub-telegram-egress
  HostName <TELEGRAM_EGRESS_HOST>
  User roehub-tunnel
  IdentityFile <HOST_LOCAL_PRIVATE_KEY_PATH>
  IdentitiesOnly yes
  BatchMode yes
  StrictHostKeyChecking yes
  ExitOnForwardFailure yes
  ConnectTimeout 10
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
