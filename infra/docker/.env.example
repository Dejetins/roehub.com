# App
APP_PORT=8000
SECRET_KEY=CHANGE_ME

# Postgres
POSTGRES_DB=roehub
POSTGRES_USER=roehub
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Optional UI profile DSN overrides (conninfo format).
# By default docker-compose derives these from POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD.
# IDENTITY_PG_DSN=host=postgres port=5432 dbname=roehub user=roehub password=CHANGE_ME
# POSTGRES_DSN=host=postgres port=5432 dbname=roehub user=roehub password=CHANGE_ME
# STRATEGY_PG_DSN=host=postgres port=5432 dbname=roehub user=roehub password=CHANGE_ME


# Connection strings (пример)
DATABASE_URL=postgresql+psycopg://roehub:CHANGE_ME@postgres:5432/roehub

# Web
WEB_API_BASE_URL=http://127.0.0.1:8010
WEB_API_UPSTREAM_URL=http://api:8000
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8000
WEB_HOST_PORT=8010

# Production image deploy
# ROEHUB_APP_IMAGE=ghcr.io/<owner>/roehub-app:main

# Local identity sessions
IDENTITY_SESSION_COOKIE_NAME=roehub_session_id
IDENTITY_SESSION_IDLE_TTL_SECONDS=1800
IDENTITY_SESSION_ABSOLUTE_TTL_SECONDS=43200

# Notification provider egress only; provider credentials live in OpenBao.
ROEHUB_NOTIFICATIONS_TELEGRAM_PROXY_URL=

# Optional Redis auth for market-data live feed
ROEHUB_REDIS_PASSWORD=
