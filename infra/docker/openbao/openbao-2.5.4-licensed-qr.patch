diff --git a/ui/ember-cli-build.js b/ui/ember-cli-build.js
--- a/ui/ember-cli-build.js
+++ b/ui/ember-cli-build.js
@@ -14,9 +14,41 @@ const isProd = environment === 'production';
 const isTest = environment === 'test';
 // const isCI = !!process.env.CI;
 
+const STABLE_EAI_MODULE_IDS = new Map([
+  ['l', 'eai-loader'],
+  ['app', 'eai-app'],
+  ['tests', 'eai-tests'],
+]);
+
+class StableEmberAutoImportModuleIdsPlugin {
+  apply(compiler) {
+    compiler.hooks.compilation.tap('RoehubStableEmberAutoImportModuleIds', (compilation) => {
+      compilation.hooks.moduleIds.tap(
+        { name: 'RoehubStableEmberAutoImportModuleIds', stage: -1000 },
+        () => {
+          const assigned = new Set();
+          for (const module of compilation.modules) {
+            const match = module.identifier().match(/[\\/](l|app|tests)\.cjs$/);
+            if (!match) continue;
+            if (assigned.has(match[1])) {
+              throw new Error(`duplicate ember-auto-import module: ${match[1]}.cjs`);
+            }
+            compilation.chunkGraph.setModuleId(module, STABLE_EAI_MODULE_IDS.get(match[1]));
+            assigned.add(match[1]);
+          }
+          if (isProd && assigned.size !== STABLE_EAI_MODULE_IDS.size) {
+            throw new Error(`expected three ember-auto-import modules, found ${assigned.size}`);
+          }
+        }
+      );
+    });
+  }
+}
