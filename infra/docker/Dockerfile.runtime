# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM ghcr.io/astral-sh/uv:0.8.4@sha256:40775a79214294fb51d097c9117592f193bcfdfc634f4daa0e169ee965b10ef0 AS uv
FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS builder

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=0 \
    UV_CONCURRENT_DOWNLOADS=8 \
    UV_CONCURRENT_INSTALLS=2 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/roehub/.venv
WORKDIR /build
COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --group data --no-install-project
COPY tools/release/THIRD_PARTY_NOTICES.md tools/release/THIRD_PARTY_NOTICES.md
COPY alembic alembic
COPY alembic.ini ./
COPY apps apps
COPY src src
COPY configs configs
COPY migrations migrations
COPY schemas schemas
COPY scripts scripts
COPY tools tools
COPY infra/openbao infra/openbao
# Release manifests and generated deployment files contain this image's digest.
# They are distributed by the signed offline bundle and mounted from the
# installation profile; retaining them inside the image would create an
# impossible self-referential digest cycle.
RUN rm -f \
    configs/installation/runtime-service-manifest.json \
    configs/installation/generated/base/compose.yaml \
    configs/installation/generated/base/control-policy.json \
    configs/installation/generated/base/generation-manifest.json \
    configs/installation/generated/trading/compose.yaml \
    configs/installation/generated/trading/control-policy.json \
    configs/installation/generated/trading/generation-manifest.json \
    configs/installation/generated/ml/compose.yaml \
    configs/installation/generated/ml/control-policy.json \
    configs/installation/generated/ml/generation-manifest.json \
    tools/release/oss_policy.json \
    tools/release/preliminary-sbom.spdx.json \
    tools/release/release-metadata.json
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --group data --no-editable && \
    dist_info="$(find /opt/roehub/.venv/lib/python3.12/site-packages \
        -maxdepth 1 -type d -name 'roehub-*.dist-info' -print -quit)" && \
    test -n "$dist_info" && \
    rm -f "$dist_info/uv_cache.json" && \
    sed -i "\|${dist_info##*/}/uv_cache.json,|d" "$dist_info/RECORD"

FROM builder AS ml-builder
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --frozen --no-dev --group data --extra rl-ml --no-editable && \
    dist_info="$(find /opt/roehub/.venv/lib/python3.12/site-packages \
        -maxdepth 1 -type d -name 'roehub-*.dist-info' -print -quit)" && \
    test -n "$dist_info" && \
    rm -f "$dist_info/uv_cache.json" && \
    sed -i "\|${dist_info##*/}/uv_cache.json,|d" "$dist_info/RECORD"

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS runtime-base
ENV PATH=/opt/roehub/.venv/bin:$PATH \
    NUMBA_CACHE_DIR=/tmp/roehub-numba-cache \
    PYTHONPATH=/opt/roehub/src:/opt/roehub \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /opt/roehub
COPY --chmod=0555 infra/docker/runtime-entrypoint.py /usr/local/bin/roehub-runtime-entrypoint
COPY --from=builder --chown=65532:65532 /build/apps apps
COPY --from=builder --chown=65532:65532 /build/src src
COPY --from=builder --chown=65532:65532 /build/configs configs
COPY --from=builder --chown=65532:65532 /build/migrations migrations
COPY --from=builder --chown=65532:65532 /build/alembic alembic
COPY --from=builder --chown=65532:65532 /build/schemas schemas
COPY --from=builder --chown=65532:65532 /build/scripts scripts
COPY --from=builder --chown=65532:65532 /build/tools tools
COPY --from=builder --chown=65532:65532 /build/infra/openbao infra/openbao
COPY --from=builder --chown=65532:65532 /build/pyproject.toml /build/uv.lock ./
COPY --from=builder --chown=65532:65532 /build/alembic.ini ./
RUN mkdir -p /var/lib/roehub/artifacts /var/lib/roehub/ml && chown -R 65532:65532 /var/lib/roehub
USER 65532:65532

FROM runtime-base AS runtime
COPY --from=builder --chown=65532:65532 /opt/roehub/.venv /opt/roehub/.venv
ENTRYPOINT ["/usr/local/bin/roehub-runtime-entrypoint"]
CMD ["python", "-m", "apps.api.main.main", "--host", "0.0.0.0", "--port", "8000"]

FROM runtime-base AS runtime-ml
COPY --from=ml-builder --chown=65532:65532 /opt/roehub/.venv /opt/roehub/.venv
ENTRYPOINT ["/usr/local/bin/roehub-runtime-entrypoint"]
CMD ["python", "-m", "apps.worker.rl_trading_inference.main.main", "status", "--config", "/etc/roehub/rl-runtime.yaml"]
