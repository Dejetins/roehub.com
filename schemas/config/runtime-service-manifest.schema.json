{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "io.roehub.runtime-service-manifest/v1alpha1",
  "title": "Roehub runtime service manifest",
  "type": "object",
  "required": ["schema", "images", "roles"],
  "properties": {
    "schema": {"const": "io.roehub.runtime-service-manifest/v1alpha1"},
    "images": {
      "type": "object",
      "required": ["runtime", "ml_runtime", "python_base", "uv_builder"],
      "properties": {
        "runtime": {"$ref": "#/$defs/digest_image"},
        "ml_runtime": {"$ref": "#/$defs/digest_image"},
        "python_base": {"$ref": "#/$defs/digest_image"},
        "uv_builder": {"$ref": "#/$defs/digest_image"}
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/role"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest_image": {
      "type": "string",
      "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
    },
    "role": {
      "type": "object",
      "required": [
        "name",
        "lifecycle",
        "component_ids",
        "entrypoints",
        "profiles",
        "image",
        "command",
        "depends_on",
        "resources"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
        "lifecycle": {
          "enum": [
            "service",
            "one-shot",
            "operator-tool",
            "isolated-job",
            "host-service",
            "host-tool"
          ]
        },
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(app|worker):[a-z0-9_]+$"}
        },
        "entrypoints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^apps/.+\\.py$"}
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["base", "trading", "ml"]}
        },
        "image": {"enum": ["runtime", "ml_runtime"]},
        "command": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "internal_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "health_path": {"type": "string", "pattern": "^/"},
        "container_health_path": {"type": "string", "pattern": "^/"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}
        },
        "config_mount": {"type": "string", "pattern": "^[a-z0-9_-]+\\.yaml$"},
        "network_access": {
          "enum": ["internal_only", "market_data_egress", "web_ingress"]
        },
        "persistent_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/"}
        },
        "resources": {
          "type": "object",
          "required": ["cpus", "memory_mb"],
          "properties": {
            "cpus": {"type": "number", "exclusiveMinimum": 0},
            "memory_mb": {"type": "integer", "minimum": 64}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"lifecycle": {"const": "service"}}},
          "then": {"required": ["internal_port", "health_path"]}
        }
      ],
      "additionalProperties": false
    }
  }
}
