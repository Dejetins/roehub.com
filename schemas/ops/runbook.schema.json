{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.roehub.io/v1/runbook.schema.json",
  "title": "Roehub machine-readable runbook",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "ops.roehub.io/v1"},
    "kind": {"const": "Runbook"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "source_legacy"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "revision": {"type": "integer", "minimum": 1},
        "source_legacy": {"type": "string", "pattern": "^docs/runbooks/[a-z0-9][a-z0-9-]*\\.md$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "severity",
        "component_ids",
        "prerequisites",
        "symptoms",
        "diagnostics",
        "allowed_actions",
        "rollback",
        "evidence",
        "secret_redaction",
        "owner",
        "related_alerts",
        "monitoring_gaps",
        "safety"
      ],
      "properties": {
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "summary": {"$ref": "#/$defs/nonEmptyText"},
        "severity": {"enum": ["info", "warning", "high", "critical"]},
        "component_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(app|context|core|worker):[a-z][a-z0-9_]*$"}
        },
        "prerequisites": {"$ref": "#/$defs/narrativeList"},
        "symptoms": {"$ref": "#/$defs/narrativeList"},
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "capability", "instruction", "expected_evidence"],
            "properties": {
              "id": {"$ref": "#/$defs/localId"},
              "capability": {"type": "string"},
              "instruction": {"$ref": "#/$defs/nonEmptyText"},
              "expected_evidence": {"$ref": "#/$defs/nonEmptyText"}
            }
          }
        },
        "allowed_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "capability", "instruction", "approval", "effect"],
            "properties": {
              "id": {"$ref": "#/$defs/localId"},
              "capability": {"type": "string"},
              "instruction": {"$ref": "#/$defs/nonEmptyText"},
              "approval": {"enum": ["none", "operator", "installation_owner"]},
              "effect": {"enum": ["read_only", "reversible", "disruptive"]}
            }
          }
        },
        "rollback": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action_ref", "instruction", "expected_evidence"],
            "properties": {
              "id": {"$ref": "#/$defs/localId"},
              "action_ref": {"$ref": "#/$defs/localId"},
              "instruction": {"$ref": "#/$defs/nonEmptyText"},
              "expected_evidence": {"$ref": "#/$defs/nonEmptyText"}
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["collect", "success_conditions", "failure_conditions"],
          "properties": {
            "collect": {"$ref": "#/$defs/narrativeList"},
            "success_conditions": {"$ref": "#/$defs/narrativeList"},
            "failure_conditions": {"$ref": "#/$defs/narrativeList"}
          }
        },
        "secret_redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["forbidden_evidence_keys", "rules"],
          "properties": {
            "forbidden_evidence_keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/localId"}
            },
            "rules": {"$ref": "#/$defs/narrativeList"}
          }
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team", "escalation_role"],
          "properties": {
            "team": {"$ref": "#/$defs/stableId"},
            "escalation_role": {"enum": ["operator", "installation_owner", "security_owner"]}
          }
        },
        "related_alerts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$"}
        },
        "monitoring_gaps": {"$ref": "#/$defs/narrativeListAllowEmpty"},
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warnings", "stop_conditions"],
          "properties": {
            "warnings": {"$ref": "#/$defs/narrativeList"},
            "stop_conditions": {"$ref": "#/$defs/narrativeList"}
          }
        }
      }
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"},
    "localId": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
    "nonEmptyText": {"type": "string", "minLength": 1},
    "narrativeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "text": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "narrativeList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/narrativeItem"}
    },
    "narrativeListAllowEmpty": {
      "type": "array",
      "items": {"$ref": "#/$defs/narrativeItem"}
    }
  }
}
