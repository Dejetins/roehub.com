{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ops.roehub.io/v1/operational-manifest.schema.json",
  "title": "Roehub generated operational manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "services"],
  "properties": {
    "schema": {"const": "io.roehub.operational-manifest/v1alpha1"},
    "profile": {"enum": ["base", "trading", "ml"]},
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/probe"}
    }
  },
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
    "referenceId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "capability",
        "kind",
        "target",
        "runbook_id",
        "action_ref",
        "required",
        "timeout_seconds"
      ],
      "properties": {
        "service_id": {"$ref": "#/$defs/stableId"},
        "capability": {"$ref": "#/$defs/referenceId"},
        "kind": {
          "enum": [
            "http_json",
            "http_reachability",
            "tcp_reachability",
            "openbao"
          ]
        },
        "target": {"type": "string", "minLength": 3, "maxLength": 512},
        "runbook_id": {"$ref": "#/$defs/referenceId"},
        "action_ref": {"$ref": "#/$defs/referenceId"},
        "required": {"type": "boolean"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}
      }
    }
  }
}
