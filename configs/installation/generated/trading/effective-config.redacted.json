{
  "architecture": "linux/arm64",
  "artifacts": {
    "mode": "local_cas",
    "path": "/var/lib/roehub/artifacts"
  },
  "capabilities": [
    "core",
    "local_artifacts",
    "market_data",
    "notifications",
    "paper_or_testnet_execution",
    "telegram_capability",
    "trading"
  ],
  "domain": "localhost",
  "installation_id": "roehub-local",
  "notifications": {
    "telegram": {
      "enabled": false
    }
  },
  "oidc": {
    "enabled": false
  },
  "openbao": {
    "address": "http://openbao:8200",
    "mode": "embedded",
    "secret_root": "kv/roehub"
  },
  "paths": {
    "artifacts": "/var/lib/roehub/artifacts",
    "config": "/etc/roehub",
    "data": "/var/lib/roehub"
  },
  "ports": {
    "api": 8000,
    "http": 8080,
    "https": 8443,
    "metrics": 9090
  },
  "profile": "trading",
  "proxy": {
    "mode": "embedded",
    "trusted_proxies": []
  },
  "resources": {
    "cpus": 4,
    "memory_mb": 4096
  },
  "schema": "io.roehub.runtime-config/v1alpha1",
  "stores": {
    "clickhouse": {
      "credentials_ref": "<secret-reference:redacted>",
      "database": "roehub",
      "host": "clickhouse",
      "mode": "embedded",
      "port": 8123,
      "tls": false
    },
    "postgresql": {
      "credentials_ref": "<secret-reference:redacted>",
      "database": "roehub",
      "host": "postgresql",
      "mode": "embedded",
      "port": 5432,
      "tls": false
    },
    "redis": {
      "credentials_ref": "<secret-reference:redacted>",
      "database": "roehub",
      "host": "redis",
      "mode": "embedded",
      "port": 6379,
      "tls": false
    }
  },
  "tls": {
    "mode": "disabled"
  },
  "trading": {
    "mode": "paper"
  },
  "update_checks": {
    "enabled": false
  }
}
