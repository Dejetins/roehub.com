<clickhouse>
    <!-- Local platform: current metrics remain available without persisting every sample. -->
    <logger><level>information</level></logger>
    <total_memory_profiler_step>0</total_memory_profiler_step>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_metric_log remove="1"/>
    <trace_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_views_log remove="1"/>
    <query_thread_log remove="1"/>
    <!-- Keep actionable diagnostics, with bounded queues and one-day retention. -->
    <query_log>
        <flush_interval_milliseconds>10000</flush_interval_milliseconds>
        <max_size_rows>4096</max_size_rows>
        <reserved_size_rows>128</reserved_size_rows>
        <buffer_size_rows_flush_threshold>2048</buffer_size_rows_flush_threshold>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <flush_interval_milliseconds>10000</flush_interval_milliseconds>
        <max_size_rows>4096</max_size_rows>
        <reserved_size_rows>128</reserved_size_rows>
        <buffer_size_rows_flush_threshold>2048</buffer_size_rows_flush_threshold>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </part_log>
    <text_log>
        <level>warning</level>
        <flush_interval_milliseconds>10000</flush_interval_milliseconds>
        <max_size_rows>4096</max_size_rows>
        <reserved_size_rows>128</reserved_size_rows>
        <buffer_size_rows_flush_threshold>2048</buffer_size_rows_flush_threshold>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </text_log>
    <error_log>
        <collect_interval_milliseconds>60000</collect_interval_milliseconds>
        <flush_interval_milliseconds>10000</flush_interval_milliseconds>
        <max_size_rows>4096</max_size_rows>
        <reserved_size_rows>128</reserved_size_rows>
        <buffer_size_rows_flush_threshold>2048</buffer_size_rows_flush_threshold>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
    </error_log>
</clickhouse>
