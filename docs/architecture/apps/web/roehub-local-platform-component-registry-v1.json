  "component_id_convention": "rh.<family>",
  "design_name_convention": "Roehub/<Family>/<Variant>",
  "allowed_widths": [820, 1024, 1440],
  "excluded_widths": [390],
  "theme_ids": ["abyss", "graphite", "slate", "frost", "paper", "sand"],
  "component_families": [
    {"component_id": "rh.application-shell", "design_name": "Roehub/Shell/Application", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"navigation": ["expanded", "compact"], "session": ["active", "warning", "expired"], "locale": ["ru", "en"]}, "accessibility": ["single_primary_navigation", "named_collapsed_controls", "keyboard_command_entry"]},
    {"component_id": "rh.page-header", "design_name": "Roehub/Layout/Page header", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"density": ["comfortable", "compact"], "actions": ["none", "primary", "secondary"]}, "accessibility": ["one_h1_per_route_screen", "actions_after_title"]},
    {"component_id": "rh.action", "design_name": "Roehub/Action/Button", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"intent": ["primary", "secondary", "quiet", "danger", "safe_action"], "state": ["enabled", "disabled", "pending", "forbidden"]}, "accessibility": ["native_button", "visible_focus", "disabled_reason_when_needed"]},
    {"component_id": "rh.field", "design_name": "Roehub/Form/Field", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"kind": ["text", "password_fallback", "select", "search", "checkbox", "radio"], "state": ["default", "invalid", "pending", "disabled"]}, "accessibility": ["programmatic_label", "error_describedby", "no_secret_echo"]},
    {"component_id": "rh.status", "design_name": "Roehub/Feedback/Status", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"tone": ["neutral", "positive", "warning", "negative", "info", "restricted"], "freshness": ["fresh", "stale", "degraded", "unavailable"]}, "accessibility": ["text_and_icon", "not_color_only"]},
    {"component_id": "rh.feedback", "design_name": "Roehub/Feedback/State", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"state": ["loading", "empty", "error_retry", "unavailable", "stale", "degraded", "forbidden", "session_expired", "recovery", "operation_unknown"]}, "accessibility": ["aria_busy_for_loading", "status_message", "safe_retry_boundary"]},
    {"component_id": "rh.data-table", "design_name": "Roehub/Data/Table", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"density": ["comfortable", "compact"], "selection": ["none", "single", "multi"], "overflow": ["contained_scroll"]}, "accessibility": ["semantic_headers", "keyboard_scroll_container", "server_filtered_projection"]},
    {"component_id": "rh.dialog", "design_name": "Roehub/Overlay/Dialog", "future_package": "@roehub/ui", "category": "shared_primitive", "variants": {"kind": ["information", "confirmation", "destructive_confirmation", "recent_auth_required", "recovery"]}, "accessibility": ["modal_focus_trap", "escape_when_safe", "return_focus_to_invoker"]},
    {"component_id": "rh.auth-gateway", "design_name": "Roehub/Auth/Gateway", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"state": ["anonymous", "passkey", "password_fallback", "recovery", "session_expired", "identity_unavailable", "invalid_next_sanitized"]}, "accessibility": ["identity_failure_explained", "sanitized_next_not_exposed"]},
    {"component_id": "rh.setup-flow", "design_name": "Roehub/Pattern/First launch", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"step": ["owner_creation", "organization_creation", "passkey", "recovery", "catalog_snapshot", "instrument_selection", "skip_selection", "empty_selection", "resume_after_failure"]}, "accessibility": ["resumable_stepper", "progress_not_authorization"]},
    {"component_id": "rh.catalog", "design_name": "Roehub/Pattern/Catalog", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"state": ["snapshot_ready", "snapshot_expired", "cursor_loading", "coverage_unknown", "artifact_unavailable", "strategy_pinned"]}, "accessibility": ["snapshot_identity_visible", "table_backed_selection"]},
    {"component_id": "rh.preflight", "design_name": "Roehub/Pattern/Preflight", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"data_mode": ["auto_selection_reason", "artifact", "direct_db"], "state": ["configure", "preflight", "resource_admission", "equivalence_failure", "validation_error", "submission_pending"]}, "accessibility": ["validation_summary", "server_admission_not_client_decision"]},
    {"component_id": "rh.runtime-control", "design_name": "Roehub/Pattern/Runtime control", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"state": ["running", "stopped", "blocked", "unknown_runtime", "safe_stop", "reconciliation", "risk_blocked", "execution_unknown"]}, "accessibility": ["server_action_status", "safe_stop_not_authorization"]},
    {"component_id": "rh.service-health", "design_name": "Roehub/Pattern/Service health", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"state": ["grouped_services", "degraded", "stale", "alert", "impact", "safe_action"]}, "accessibility": ["impact_text", "safe_action_confirmation"]},
    {"component_id": "rh.connection", "design_name": "Roehub/Pattern/Connection", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"state": ["validation_pending", "connected", "disconnected", "safe_status_only", "recent_auth_required"]}, "accessibility": ["redacted_status", "secret_never_rendered"]},
    {"component_id": "rh.chart", "design_name": "Roehub/Chart/Spec", "future_package": "@roehub/charts", "category": "shared_primitive", "variants": {"kind": ["timeseries", "candlestick", "bar", "area", "scatter", "distribution", "heatmap", "status_timeline", "comparison"], "renderer": ["canvas", "svg"], "freshness": ["fresh", "stale", "degraded", "unavailable"]}, "accessibility": ["description", "units_timezone_source_freshness", "table_alternative"]},
    {"component_id": "rh.progress.job", "design_name": "Roehub/Feedback/Job progress", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"job_state": ["queued", "running", "insufficient_confidence", "eta_unavailable", "materializing", "completed", "failed", "cancelled", "operation_unknown"], "eta_confidence": ["high", "medium", "low", "insufficient"]}, "accessibility": ["measured_progress_only", "queue_and_execution_eta_separate", "polite_status_changes"]},
    {"component_id": "rh.recovery", "design_name": "Roehub/Pattern/Recovery", "future_package": "@roehub/ui", "category": "local_platform_pattern", "variants": {"state": ["not_found_404", "permission_forbidden_403", "identity_unavailable_502", "service_unavailable_503", "proxy_failure_502", "retry", "safe_recovery"]}, "accessibility": ["error_code_and_explanation", "reconciliation_before_duplicate_retry"]}
  ],
  "chart_contract": {
    "schema_id": "io.roehub.chart-spec/v1",
    "allowed_spec_fields": ["chart_id", "kind", "title_key", "description_key", "units", "timezone", "source", "freshness", "series", "axes", "legend", "interaction", "renderer", "table_alternative", "accessibility_summary"],
    "allowed_kinds": ["timeseries", "candlestick", "bar", "area", "scatter", "distribution", "heatmap", "status_timeline", "comparison"],
    "allowed_renderers": ["canvas", "svg"],
    "prohibited": ["raw_javascript_callbacks", "executable_formatter", "html_tooltip", "secret_bearing_tooltip", "arbitrary_plugin", "unrestricted_echarts_option", "arbitrary_renderer", "arbitrary_dataset_transform"],
    "required_metadata": ["units", "timezone", "source", "freshness", "legend", "accessibility_summary", "table_alternative"]
  },
  "progress_contract": {
    "required_fields": ["job_state", "completed_units", "total_units", "queued_at", "started_at", "observed_at", "queue_position", "queue_eta", "execution_eta", "eta_confidence", "terminal_at", "failure_category", "cancellation_reason"],
    "queue_and_execution_eta_are_distinct": true,
    "measured_percent_expression": "completed_units / total_units * 100",
    "eta_visibility": {"high": "show", "medium": "show", "low": "suppress_duration", "insufficient": "suppress_duration"},
    "terminal_states": ["completed", "failed", "cancelled"],
    "active_bar_hidden_after_terminal": true,
    "prohibited": ["decorative_timer", "false_100_percent", "success_without_terminal_server_result", "retry_without_reconciliation_for_unknown_result"]
  },
