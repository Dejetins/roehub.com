  "graph_policy": {
    "node_granularity": "registered_screen_or_explicit_external_boundary",
    "transition_granularity": "cross_screen_only",
    "same_screen_state_policy": "Screen-local validation, loading, failure, retry, confirmation, and recovery states remain required_states coverage and do not create self-loop journey edges.",
    "terminal_policy": "A terminal screen has no outgoing transition. A screen that can continue to another registered screen is intermediate even when a user may pause there.",
    "supporting_link_policy": "A supporting or deep link is included only when it is part of the bounded journey completion graph; unrelated links remain navigation relationships.",
    "failure_policy": "A failure or recovery screen is declared only when the failure crosses a registered screen boundary. Same-screen failure and recovery remain intra_screen_paths.",
    "external_boundary_policy": "External boundaries are used only for a real identity, provider, or system handoff that has no registered product screen.",
