+def _tp_sl_select_top_k_indices_with_ordinals(
+    scores: np.ndarray,
+    trade_count: np.ndarray,
+    best_tp_idx: np.ndarray,
+    best_sl_idx: np.ndarray,
+    tp_values: np.ndarray,
