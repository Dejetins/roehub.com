{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roehub.local/schemas/ui-component-registry-v1.json",
  "title": "Roehub UI component registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "registry_id",
    "ticket_id",
    "state",
    "visual_standard",
    "library",
    "assets"
  ],
  "properties": {
    "schema_id": {
      "const": "io.roehub.ui.component-registry/v1"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "ticket_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": ["draft", "gated", "published_and_enabled", "archived"]
    },
    "visual_standard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status", "accepted_revision_sha256"],
      "properties": {
        "path": {
          "const": "docs/architecture/ui/roehub-linear-black-authenticated-workspace-visual-standard-v1.md"
        },
        "status": {
          "enum": ["proposed_for_library_slice_review", "accepted"]
        },
        "accepted_revision_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_key", "file_name", "revision_id", "publication_status"],
      "properties": {
        "file_key": {"const": "rgbNUPCuV7q2pARG4Cml8V"},
        "file_name": {"const": "Roehub UI Library"},
        "revision_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        },
        "publication_status": {
          "enum": ["unpublished", "published", "published_and_enabled"]
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stable_id",
          "name",
          "kind",
          "page_id",
          "node_id",
          "component_key",
          "properties",
          "variants",
          "slots",
          "content_limits",
          "token_bindings",
          "text_style_bindings",
          "accessibility_names",
          "lifecycle_status"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]+$"
          },
          "name": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "variable_collection",
              "variable",
              "text_style",
              "paint_style",
              "icon",
              "component",
              "component_set",
              "pattern"
            ]
          },
          "page_id": {"type": "string", "minLength": 1},
          "node_id": {"type": "string", "minLength": 1},
          "component_key": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1}
            ]
          },
          "properties": {"type": "object"},
          "variants": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "slots": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "content_limits": {"type": "object"},
          "token_bindings": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "text_style_bindings": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "accessibility_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "lifecycle_status": {
            "enum": [
              "sandbox_candidate",
              "gated",
              "accepted_unpublished",
              "published_and_enabled",
              "archived"
            ]
          }
        }
      }
    }
  }
}
